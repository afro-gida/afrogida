# Kopyala: .env.example -> .env (gercek .env repoya girmez, kok .gitignore'da)
#
# Gelistirme varsayilani: ayni bilgisayarda calisan backend/run_dev_server.py.
# Gercek cihazda (Expo Go / telefon) test icin bu bilgisayarin LAN IP'sini kullan,
# ornek: EXPO_PUBLIC_API_URL=http://192.168.1.23:8000/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api
