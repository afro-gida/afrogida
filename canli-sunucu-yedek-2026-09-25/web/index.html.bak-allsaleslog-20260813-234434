      return e.children.length === 0 && /^₺\s*[\d.,]+$/.test((e.textContent || '').trim());
    });
  }
  // Satır içindeki SATIR TOPLAMI yaprağı (en sağdaki bağımsız ₺ değeri; chip
  // "+₺10" fiyatları hariç -> onlar "^₺..$" kalıbına uymaz veya '+' önekli).
  function lineTotalLeaf(row) {
    var cands = exactTLLeaves(row).filter(function (l) { return !l.closest('[data-afro-optsum]'); });
    if (!cands.length) return null;
    cands.sort(function (a, b) { return b.getBoundingClientRect().left - a.getBoundingClientRect().left; });
    return cands[0];
  }
  // "1.0 Kg x ₺10,00" satır metninden BİRİM fiyatı çöz.
  function unitPriceFromRow(row) {
    var m = (row.innerText || '').match(/[x×]\s*₺\s*([\d.,]+)/i);
    return m ? parseTL('₺' + m[1]) : null;
  }
  function unitPriceOf(id, row) {
    var u = row ? unitPriceFromRow(row) : null;
    if (u != null && u > 0) return u;
    return basePrice(window.__afroProducts[id] || {});
  }
  // Sepet satırına seçili seçenek + not ÖZETİNİ (salt-okunur) enjekte et.
  function injectOptSummary(row, id) {
    var c = customs()[id] || {};
    var opts = c.selected_options || [];
    var note = (c.note || '').trim();
    // Küresel tekillik: findCartRow tik'ler arası farklı kapsayıcı döndürebildiği
    // için dedup'ı BELGE genelinde yap; aksi halde her kapsayıcıya ayrı kutu
    // eklenip özet MÜKERRER görünür. Bu ürün için tek kutu tut, fazlasını sil.
    var existing = document.querySelectorAll('[data-afro-optsum][data-afro-for="' + id + '"]');
    if (!opts.length && !note) { for (var d = 0; d < existing.length; d++) existing[d].remove(); return; }
    var box = existing[0] || null;
    for (var d2 = 1; d2 < existing.length; d2++) existing[d2].remove();
    var labels = opts.map(function (o) { return o.label; }).filter(Boolean);
    var txt = '';
    if (labels.length) txt += 'Seçili: ' + labels.join(', ');
    if (note) txt += (txt ? '  ·  ' : '') + 'Not: ' + note;
    if (!box) {
      box = document.createElement('div');
      box.setAttribute('data-afro-optsum', '1');
      box.setAttribute('data-afro-for', id);
    }
    // KARARLILIK: findCartRow tik'ler arası 91px/59px iç-içe kaplar arasında
    // gidip geldiği için HER tik row.appendChild yapmak kutuyu ~4px oynatıp
    // "yazılar hareket ediyor" titremesine yol açıyordu. Kutuyu yalnızca DOM'dan
    // düşmüşse (React satırı yeniden çizmişse) yeniden ekle; aksi halde YERİNDE
    // bırak -> titreme biter.
    if (!box.isConnected) row.appendChild(box);
    // Satır flex bir kap; kutuyu DAİMA tam-genişlik (kendi satırı) yaparak
    // fiyatın yanına sıkışıp ürün adını dikey ezmesini engelle. cssText'i her
    // tik yeniden yazmamak için değişiklik olduğunda uygula (gereksiz reflow yok).
    var css = 'flex:0 0 100%;width:100%;margin-top:6px;font-size:12.5px;line-height:1.4;font-weight:600;color:' + accent() + ';';
    if (box.getAttribute('data-afro-css') !== css) { box.style.cssText = css; box.setAttribute('data-afro-css', css); }
    if (box.textContent !== txt) box.textContent = txt;
  }
  // Sepet ÖZET/BAR toplam yaprakları: "... çeşit ürün • ₺XX" başlıkları ve
  // "Siparişi Tamamla/Onayla/Öde" barları. (Sepet satırı içindekiler hariç.)
  function summaryLeaves() {
    var hosts = Array.prototype.slice.call(document.querySelectorAll('*')).filter(function (e) {
      var t = e.textContent || '';
      // NOT: "Ödeme"nin ardından harf gelirse (ör. "ödemelerde") eşleşme -> bu,
      // Kuponlar sayfası alt başlığını yakalayıp indirim rozetini bozuyordu.
      // Negatif ileri-bakış ile yalnızca gerçek "Ödeme" (bar/başlık) eşleşsin.
      if (!/(çeşit ürün|Siparişi|Tamamla|Onayla|Ödeme(?![a-zçğıöşü]))/i.test(t)) return false;
      var lv = exactTLLeaves(e);
      return lv.length >= 1 && lv.length <= 2 && e.children.length <= 10;
    });
    var out = [], seen = [];
    hosts.forEach(function (h) {
      exactTLLeaves(h).forEach(function (l) {
        if (l.closest('[data-afro-cartrow]')) return;
        if (seen.indexOf(l) > -1) return;
        seen.push(l); out.push(l);
      });
    });
    return out;
  }
  // Sepet toplamlarını KAYNAK-DOĞRUSUNDAN hesaplayıp yaz + her sepet satırına
  // seçim özetini bas. Satır toplamı = (birim + seçenek ücretleri) × adet.
  // Genel toplam = tüm satır toplamlarının toplamı. Backend'in tahsil ettiği
  // ile birebir aynı (backend de options_fee_unit × qty uygular).
  // Sepette açık kalmış ESKİ native inline editörleri kapat ("Kapat" toggle'ına
  // sentetik tık; isTrusted=false olduğu için kendi capture handler'ımız yok sayar).
  function closeStrayNativeEditors() {
    try {
      var els = document.querySelectorAll('*');
      for (var i = 0; i < els.length; i++) {
        var e = els[i];
        if (e.children.length > 1) continue;
        if (normTxt(e.textContent) === 'Kapat') { fireClick(e); break; }
      }
    } catch (e) {}
  }
  // Sepet satırındaki "1.0 Kg x ₺10,00" gibi adet etiketini afro_basket
  // adediyle senkronla. (Panelde adet değiştirilince native stepper stale
  // kalıp yanlış adet gösterebiliyordu; satır toplamı doğruyken adet metni
  // eski kalıyordu. Bu, adet metnini kaynak-doğrusuyla eşitler.)
  function fmtQtyLabel(qty, unit) {
    var q = Number(qty) || 0;
    if (/kg/i.test(String(unit || ''))) return q.toFixed(1);
    return (q % 1 === 0) ? String(q) : q.toFixed(1);
  }
  function patchQtyLabel(row, qty, unit) {
    try {
      var qs = fmtQtyLabel(qty, unit);
      var leaves = Array.prototype.slice.call(row.querySelectorAll('*')).filter(function (e) {
        return e.children.length === 0 && /[x×]\s*\u20BA/.test(e.textContent || '') && /^\s*[\d.,]+/.test(e.textContent || '');
      });
      leaves.forEach(function (l) {
        var t = l.textContent;
        var nt = t.replace(/^(\s*)[\d.,]+/, '$1' + qs);
        if (nt !== t) l.textContent = nt;
      });
    } catch (e) {}
  }
  // Sepet satırındaki − N + stepper'ının ORTA sayısını afro_basket adediyle
  // eşitle. (Native "+" tıklaması sepet satırında güvenilir çalışmadığı için
  // sayı eski değerde -0.5- takılı kalıyordu; artık kaynak-doğrusundan yazılır.)
  function patchStepperQty(row, qty, unit) {
    try {
      var st = cartStepper(row); if (!st || !st.numLeaf) return;
      var qs = fmtQtyLabel(qty, unit);
      if ((st.numLeaf.textContent || '').trim() !== qs) st.numLeaf.textContent = qs;
    } catch (e) {}
  }

  // Sepette adedi 0 olan (ör. sepet boşaltılan) ürünlerin özelleştirmelerini
  // sil ki tekrar eklendiğinde eski seçimler ("Test 2/Test 4") işaretli
  // gelmesin; varsayılan "İstemiyorum" olsun.
  function pruneStaleCustoms() {
    try {
      var cs = customs(), bk = basket(), changed = false;
      Object.keys(cs).forEach(function (id) {
        if (!(Number(bk[id]) > 0)) { delete cs[id]; changed = true; }
      });
      if (changed) jset(CUSTOM_KEY, cs);
    } catch (e) {}
  }

  // Bir kök içindeki tam-₺ yaprakları (belge sırasında).
  function tlLeavesIn(root) {
    return Array.prototype.slice.call(root.querySelectorAll('*')).filter(function (e) {
      return e.children.length === 0 && /^₺\s*[\d.,]+$/.test((e.textContent || '').trim());
    });
  }
  // Bir ETİKET yaprağının (ör. "Ara Toplam") satırındaki ₺ DEĞER yaprağını bul.
  // Layout-bağımsız: etiketin en yakın ₺ içeren atasına çık, o ata içinde
  // etiketten SONRA gelen ilk ₺ yaprağını al (satır düzeni "Etiket ... ₺Değer").
  function valueLeafFor(labelLeaf) {
    var node = labelLeaf.parentElement, anc = null;
    for (var up = 0; up < 5 && node; up++, node = node.parentElement) {
      if (tlLeavesIn(node).length) { anc = node; break; }
    }
    if (!anc) return null;
    var tls = tlLeavesIn(anc);
    for (var k = 0; k < tls.length; k++) {
      if (labelLeaf.compareDocumentPosition(tls[k]) & 4 /*FOLLOWING*/) return tls[k];
    }
    return tls.length ? tls[tls.length - 1] : null;
  }
  // Sepet özetindeki Ara Toplam / Toplam -> grand, Kalan Tutar -> max(0, min-grand).
  // "Minimum Sipariş Tutarı" ve "Gel-Al Saati" değerlerine DOKUNMA. Kutu geometrisi
  // yerine etiket->değer eşlemesi kullanılır; her tema/düzende (Minimum/Kalan VEYA
  // "teslim alınmadı" notu) güvenilir çalışır.
  function patchSummaryBox(grand) {
    var all = document.querySelectorAll('*');
    var labels = [];
    for (var i = 0; i < all.length; i++) {
      var e = all[i];
      if (e.children.length !== 0) continue;
      var t = (e.textContent || '').trim();
      if (/^Ara Toplam$/i.test(t) || /^Toplam$/i.test(t) ||
          /^Kalan Tutar$/i.test(t) || /^Minimum/i.test(t)) {
        labels.push({ leaf: e, t: t });
      }
    }
    // 1) minimum sipariş tutarını oku (Kalan Tutar hesabı için)
    var minimum = null;
    labels.forEach(function (o) {
      if (!/^Minimum/i.test(o.t)) return;
      var vl = valueLeafFor(o.leaf); if (!vl) return;
      var v = parseTL(vl.textContent); if (v != null) minimum = v;
    });
    // 2) değerleri kaynak-doğrusundan yaz
    labels.forEach(function (o) {
      if (/^Minimum/i.test(o.t)) return;                 // sabit eşik: dokunma
      var vl = valueLeafFor(o.leaf); if (!vl) return;
      if (/^Kalan Tutar$/i.test(o.t)) {
        if (minimum != null) setLeafAbs(vl, Math.max(0, Math.round((minimum - grand) * 100) / 100));
      } else {
        setLeafAbs(vl, grand);                           // Ara Toplam / Toplam
      }
    });
  }
  // "N çeşit ürün • ₺X" başlığı TEK birleşik metin düğümü ("1 çeşit ürün • ₺50.00").
  // İçindeki ₺ değerini grand ile değiştir (sayı-etiketi metin içinde gömülü).
  function patchCesitHeaders(grand) {
    var g = '₺' + (Math.round((grand || 0) * 100) / 100).toFixed(2);
    var all = document.querySelectorAll('*');
    for (var i = 0; i < all.length; i++) {
      var e = all[i];
      if (e.children.length !== 0) continue;
      var t = e.textContent || '';
      if (t.indexOf('çeşit ürün') === -1 || !/₺\s*[\d.,]+/.test(t)) continue;
      var nt = t.replace(/₺\s*[\d.,]+/, g);
      if (nt !== t) e.textContent = nt;
    }
  }

  // ÜRÜNLER SAYFASI ALT BARI: /(tabs)/products sayfasındaki alttan çıkan
  // "Siparişi Tamamla ₺XX" çubuğunun toplamını seçim ek ücretlerini içerecek
  // şekilde düzelt. patchCartTotals() eskiden yalnızca /cart'ta özet/bar
  // yamalıyordu; ürünler sayfasındaki bar seçim ücretlerini yansıtmıyordu
  // (kullanıcı: "seçim tutarları sepete işlemiyor"). Yalnızca "Siparişi
  // Tamamla" ibaresini taşıyan çubuğu hedefleriz -> Kuponlar/Ödeme gibi
  // diğer sayfalardaki ₺ değerlerine ASLA dokunmaz (güvenli, dar kapsam).
  function patchOrderBar(grand) {
    try {
      var hosts = Array.prototype.slice.call(document.querySelectorAll('*')).filter(function (e) {
        var t = normTxt(e.textContent || '');
        if (!/Sipari[şs]i\s*Tamamla/i.test(t)) return false;
        if (e.children.length > 12) return false;
        var lv = exactTLLeaves(e);
        return lv.length >= 1 && lv.length <= 2;
      });
      var seen = [];
      hosts.forEach(function (h) {
        exactTLLeaves(h).forEach(function (l) {
          if (l.closest('[data-afro-cartrow]')) return;
          if (seen.indexOf(l) > -1) return;
          seen.push(l);
          setLeafAbs(l, grand);
        });
      });
    } catch (e) {}
  }

  function patchCartTotals() {
    try {
      pruneStaleCustoms();
      var b = basket();
      var grand = 0, anyExtra = false, qtyDiff = false, onCart = isCartPage();
      if (onCart) { closeStrayNativeEditors(); hideOzellestirButtons(); }
      Object.keys(b).forEach(function (id) {
        var qty = Number(b[id] || 0); if (qty <= 0) return;
        var extra = optExtraFor(id); if (extra > 0) anyExtra = true;
        var row = onCart ? findCartRow(id) : null;
        var unit = unitPriceOf(id, row);
        var line = Math.round((unit + extra) * qty * 100) / 100;
        grand += line;
        if (row) {
          row.setAttribute('data-afro-cartrow', '1');
          var pu = (window.__afroProducts[id] || {}).unit;
          // Özelleştirilebilir ürün satırını tıklanabilir göster (menü açılır).
          var prod = window.__afroProducts[id] || {};
          if (((prod.customization_options || []).length > 0) || prod.customization_note_enabled) {
            if (row.style.cursor !== 'pointer') row.style.cursor = 'pointer';
          }
          injectOptSummary(row, id);
          // Native stepper afro_basket'ten sapmışsa (panelde adet değişti ama
          // native "+" güncellenmedi) sayıyı + alt yazıyı + toplamı eşitle.
          var st = cartStepper(row);
          var nq = st ? st.val : qty;
          if (Math.abs(nq - qty) > 1e-6) { qtyDiff = true; patchStepperQty(row, qty, pu); }
          patchQtyLabel(row, qty, pu);
          var lineLeaf = lineTotalLeaf(row);
          if (lineLeaf) setLeafAbs(lineLeaf, line);
        }
      });
      grand = Math.round(grand * 100) / 100;
      // Ekstra seçim ücreti VEYA adet sapması varken SEPET SAYFASINDAKİ özet/bar
      // toplamlarını kaynak-doğrusundan düzelt.
      // ÖNEMLİ (kupon hatası düzeltmesi): bu blok eskiden HER sayfada çalışıyordu.
      // summaryLeaves() Kuponlar sayfasını da yakalıyordu (alt başlık "Sadece
      // online ödemelerde geçerlidir" -> /Ödeme/ eşleşmesi + sayfadaki tek ₺
      // rozet <=2 filtresine takılıyor) ve kuponun indirim tutarını SEPET
      // TOPLAMIYLA eziyordu (ör. ₺100 -> ₺90). Artık yalnızca /cart sayfasında
      // çalışır; sepet dışındaki hiçbir ₺ değerine (kupon rozeti vb.) dokunmaz.
      if ((anyExtra || qtyDiff) && onCart) {
        summaryLeaves().forEach(function (leaf) { setLeafAbs(leaf, grand); });
        patchSummaryBox(grand); patchCesitHeaders(grand);
      }
      // SEPET DIŞI (ör. ürünler sayfası): alttaki "Siparişi Tamamla" barını
      // seçim ücretlerini içerecek şekilde düzelt. Yalnızca ek ücret varken
      // ve yalnızca o çubuğu hedefler (diğer sayfaların ₺ değerlerine dokunmaz).
      if (anyExtra && !onCart) {
        patchOrderBar(grand);
      }
    } catch (e) {}
  }

  // Yoğun yeniden-yama penceresi: "Güncelle"den sonra HER ekran karesinde
  // (requestAnimationFrame) ~1.5sn boyunca patchCartTotals çağır. Panel kapanma
  // animasyonu bitip uygulama satırı native değeriyle yeniden çizse bile o
  // frame'de anında üzerine doğru değer yazılır -> gözle görülür gecikme kalmaz.
  var _burstUntil = 0, _burstRunning = false;
  function burstPatchCart(ms) {
    _burstUntil = Date.now() + (ms || 1500);
    if (_burstRunning) return;
    _burstRunning = true;
    (function loop() {
      try { patchCartTotals(); } catch (e) {}
      if (Date.now() < _burstUntil) {
        (window.requestAnimationFrame || function (f) { setTimeout(f, 16); })(loop);
      } else { _burstRunning = false; }
    })();
  }

  // tema değişkenlerini + sepet toplamlarını periyodik uygula
  function syncThemeVars() {
    var a = accent();
    var soft = isDark() ? 'rgba(20,182,126,.14)' : 'rgba(251,140,60,.14)';
    document.documentElement.style.setProperty('--afroAcc', a);
    document.documentElement.style.setProperty('--afroAccSoft', soft);
    if (el.body) {
      var pp = el.body.querySelector('.afroPPrice');
      if (pp) pp.style.color = a;
    }
    patchCartTotals();
  }
  setInterval(syncThemeVars, 350);
  syncThemeVars();

  // FLAŞ ÖNLEME: 350ms'lik aralık gelene kadar native "Özelleştir" pili ilk
  // açılışta bir an görünüyordu. DOM değişimlerini izleyip aynı ekran karesinde
  // (rAF) gizle -> göze çarpan flaş kalmaz. Kare başına en çok bir tarama olsun
  // diye rAF ile debounce edilir.
  var _hideScheduled = false;
  function scheduleHideOz() {
    if (_hideScheduled) return;
    _hideScheduled = true;
    (window.requestAnimationFrame || function (f) { setTimeout(f, 16); })(function () {
      _hideScheduled = false;
      try { if (isCartPage()) hideOzellestirButtons(); } catch (e) {}
    });
  }
  try {
    new MutationObserver(scheduleHideOz).observe(document.documentElement, { childList: true, subtree: true });
    scheduleHideOz();
  } catch (e) {}

  // Ürün önbelleğini önden doldur: /cart'a doğrudan girişte ürün adı->id
  // eşleşmesi (cartRowId) ilk tıkta hazır olsun.
  try { ensureProducts(); } catch (e) {}

  // ============================================================
  // SİPARİŞ YÖNETİM PANELİ: Final durumlarda değişiklik engelle
  // ============================================================
  function lockFinalOrderStatus() {
    try {
      var path = window.location.pathname || '';
      // Admin sipariş detay sayfası mı? (URL'de order veya admin geçiyor mu kontrol et)
      if (!(path.includes('/order') || path.includes('/admin'))) return;

      // Tüm select/picker elementlerini tara
      var selects = document.querySelectorAll('select, [role="combobox"], [role="listbox"]');
      selects.forEach(function(sel) {
        try {
          // Seçili option'ın text'ini al
          var selectedText = '';
          if (sel.tagName === 'SELECT') {
            var opt = sel.options[sel.selectedIndex];
            selectedText = opt ? (opt.textContent || opt.innerText || '').trim() : '';
          } else {
            // React Native picker için: seçili değeri içeren text'i bul
            selectedText = (sel.textContent || sel.innerText || '').trim();
          }

          // Final durum kontrolü (büyük/küçük harf duyarsız)
          var finalStatuses = [
            'teslim edildi', 'teslim_edildi',
            'iptal edildi', 'iptal_edildi', 'iptäl',
            'teslim alınmadı', 'teslim_alinmadi',
            'müşteri gelmedi', 'musteri_gelmedi'
          ];
          var isFinal = finalStatuses.some(function(s) {
            return selectedText.toLowerCase().includes(s);
          });

          if (isFinal) {
            // Dropdown'u kilitle
            sel.disabled = true;
            sel.style.pointerEvents = 'none';
            sel.style.opacity = '0.5';
            sel.style.cursor = 'not-allowed';
            sel.setAttribute('data-afro-locked', '1');
          }
        } catch (e) {}
      });

      // "İptal" veya "Cancel" butonu varsa gizle (final durumda)
      var buttons = document.querySelectorAll('button, [role="button"]');
      buttons.forEach(function(btn) {
        try {
          var text = (btn.textContent || btn.innerText || '').trim().toLowerCase();
          // İptal butonu + sayfada final durum var mı?
          if ((text.includes('iptal') || text.includes('cancel')) && 
              document.querySelector('[data-afro-locked="1"]')) {
            btn.style.display = 'none';
            btn.style.visibility = 'hidden';
          }
        } catch (e) {}
      });
    } catch (e) {}
  }

  // Periyodik çalıştır (React sayfayı yeniden çizebilir)
  setInterval(lockFinalOrderStatus, 400);
  lockFinalOrderStatus();
})();
    </script>

