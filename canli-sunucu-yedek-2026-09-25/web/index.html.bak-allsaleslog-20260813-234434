      if (r.width < 180 || r.height < 56 || r.height > 900) continue;
      var txt = d.innerText || '';
      if (txt.indexOf(name) === -1) continue;
      // Ürünün KENDİ satırı olmalı: birim fiyat kalıbı ("Kg x ₺..") içermeli ve
      // TEK bir ürünü sarmalı. Özelleştir'i olmayan (seçeneksiz) ürünlerde eski
      // /Özelleştir|Kapat/ koşulu komşu satırı da içeren büyük kabı seçip yanlış
      // birim fiyat okumaya yol açıyordu; bunun yerine "x ₺" kalıbını sayıyoruz.
