          var h = document.createElement('h2');
          h.style.cssText = 'margin:0;font-size:20px;color:#eafff4;';
          h.textContent = 'Satış Logu — ' + supplierGroup;
          var closeBtn = document.createElement('button');
          closeBtn.textContent = 'Kapat';
          closeBtn.style.cssText = 'background:#10291e;color:#fff;border:0;border-radius:10px;padding:10px 15px;font-weight:800;cursor:pointer;';
          closeBtn.onclick = function () { m.remove(); };
          top.appendChild(h); top.appendChild(closeBtn);
          var body = document.createElement('div');
