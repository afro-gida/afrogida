        // ============================================================
        // TEDARİKÇİ SATIŞ LOGU SAYFASI (tam ekran modal)
        // Seçili tedarikçinin satılan (teslim edilen) ürünlerini listeler;
        // ürün/miktar/fiyat gösterir, iade olanları "İade edildi" işaretler
        // ve tutarı net toplamdan düşer.
        // ============================================================
        function afroOpenSalesLog(supplierGroup) {
          var old = document.getElementById('afro-saleslog-modal');
          if (old && old.parentNode) old.parentNode.removeChild(old);
          var m = document.createElement('div');
          m.id = 'afro-saleslog-modal';
          m.style.cssText = 'position:fixed;inset:0;z-index:2147483040;background:rgba(1,20,10,0.96);color:#eafff4;font-family:Arial,sans-serif;overflow:auto;';
          var card = document.createElement('div');
