      // (syncCartRow/setNativeQty'nin fireClick'leri buraya düşmesin.)
      if (!ev.isTrusted) return;
      if (ev.target && ev.target.closest && ev.target.closest('[data-afro-panel]')) return; // panelin kendisi

      // SEPET: native "Özelleştir"/"Kapat" -> bizim panel.
      // Bir sepet toggle'ına tıklandıysa native inline editörü ASLA açtırma;
      // her koşulda engelle, ürünü çözüp kendi panelimizi aç (önbellek boşsa
      // async doldurup tekrar dene).
