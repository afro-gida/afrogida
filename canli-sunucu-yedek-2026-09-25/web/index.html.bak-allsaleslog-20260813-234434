<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta httpEquiv="X-UA-Compatible" content="IE=edge" />
    <meta httpEquiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta httpEquiv="Pragma" content="no-cache" />
    <meta httpEquiv="Expires" content="0" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Afro Gıda</title>
    <!-- The `react-native-web` recommended style reset: https://necolas.github.io/react-native-web/docs/setup/#root-element -->
    <style id="expo-reset">
      /* These styles make the body full-height */
      html,
      body {
        height: 100%;
      }
      /* These styles disable body scrolling if you are using <ScrollView> */
      body {
        overflow: hidden;
      }
      /* These styles make the root element full-height */
      #root {
        display: flex;
        height: 100%;
        flex: 1;
      }

      /* ================================================================
         AFRO GIDA - SABİT DUVAR KAĞIDI (Telegram tarzı)
         Hem DARK hem LIGHT MODE + MÜŞTERİ kısmında aktif.
         ÖNEMLİ: Sayfa katmanlarını ŞEFFAF yapmıyoruz (bu, eski sayfaların
         iç içe görünmesine yol açıyordu). Bunun yerine tam-ekran sayfa
         katmanlarının arka planına duvar kağıdını SABİT resim olarak
         basıyoruz. Sayfalar opak kalır (arkadakini gizler), duvar kağıdı
         kartların arasındaki boşluklarda görünür ve kaydırınca sabit kalır.
         ================================================================ */
      /* KOYU MOD DUVAR KAĞIDI */
      html.afro-wp.afro-dark [data-afro-wp="1"] {
        background-color: #0d0d0d !important;
        background-image: url(/afro_wallpaper_dark.jpg) !important;
        background-position: center top !important;
        background-size: cover !important;
        background-repeat: no-repeat !important;
        background-attachment: fixed !important;
      }
      /* AÇIK MOD DUVAR KAĞIDI */
      html.afro-wp.afro-light [data-afro-wp="1"] {
        background-color: #f9f4ed !important;
        background-image: url(/afro_wallpaper_light.jpg) !important;
        background-position: center top !important;
        background-size: cover !important;
        background-repeat: no-repeat !important;
        background-attachment: fixed !important;
      }

      /* ================================================================
         BUZLU CAM (frosted glass) - AÇIK MODDAKİ BEYAZ KART/PANELLER
         Beyaz alanları yarı şeffaf + arka bulanıklık yapar; böylece
         duvar kağıdı kartların arkasından bulanık şekilde görünür.
         ================================================================ */
      html.afro-wp.afro-light [data-afro-glass="1"] {
        background-color: rgba(255, 255, 255, 0.45) !important;
        -webkit-backdrop-filter: blur(14px) saturate(1.3) !important;
        backdrop-filter: blur(14px) saturate(1.3) !important;
      }

      /* KULLANICI İSTEĞİ: bilgi kutucukları (Pazar/Gel-Al saati) ve ana/alt
         kategori butonlarının ARKASINDAKİ geniş beyaz-buzlu bandı KALDIR.
         Bu bantlar tamamen şeffaf olur; böylece duvar kağıdı butonların
         arkasından net görünür (butonların kendisi dokunulmadan kalır). */
      html.afro-wp.afro-light [data-afro-glass-clear="1"] {
        background-color: rgba(255, 255, 255, 0.12) !important;
        background-image: none !important;
        -webkit-backdrop-filter: blur(10px) saturate(1.25) !important;
        backdrop-filter: blur(10px) saturate(1.25) !important;
        box-shadow: none !important;
      }

      /* KULLANICI İSTEĞİ: KOYU MODDA da kategori/bilgi bantlarını şeffaflaştır */
      html.afro-wp.afro-dark [data-afro-dark-clear="1"] {
        background-color: transparent !important;
        background-image: none !important;
        box-shadow: none !important;
      }

      /* ================================================================
         KULLANICI İSTEĞİ: ÜRÜNLER SAYFASI BÖLÜM BAŞLIĞI BANTLARI
         ("Çok al az öde", "Domates", "Biber" ... = ana kategori isimleri)
         Bu bantların arkasındaki buzlu-şeffaf zemin kaydırınca kayboluyordu
         (uygulama onları saydam render ediyor, genel painter ise ancak soluk
         renkli düğümleri yakaladığı için tutarsızdı). Özel painter ile HER
         bant işaretlenir (data-afro-secband) -> zemin STABİL kalır + etrafına
         turuncu (koyu temada yeşil) kenarlık eklenir. Bu blok tamamen geri
         alınabilir: yedek index_wallpaper.html.bak-secband-* dosyalarında.
         ================================================================ */
      html.afro-wp.afro-light [data-afro-secband="1"] {
        background-color: rgba(255, 255, 255, 0.45) !important;
        -webkit-backdrop-filter: blur(14px) saturate(1.3) !important;
        backdrop-filter: blur(14px) saturate(1.3) !important;
        border: 1.5px solid rgb(251, 140, 60) !important;
        border-radius: 9px !important;
      }
      html.afro-wp.afro-dark [data-afro-secband="1"] {
        background-color: rgba(18, 40, 30, 0.38) !important;
        -webkit-backdrop-filter: blur(14px) saturate(1.2) !important;
        backdrop-filter: blur(14px) saturate(1.2) !important;
        border: 1.5px solid rgb(20, 182, 126) !important;
        border-radius: 9px !important;
      }

      /* ================================================================
         TURUNCU BUTONLAR (HER İKİ MOD) - yeşil marka butonlarını
         uygulamanın turuncu aksanına (rgb(251,140,60)) çevirir. Hem açık
         hem koyu modda uygulanır.
         ================================================================ */
      /* AÇIK TEMA: dolu yeşil butonlar -> turuncu */
      html.afro-wp.afro-light [data-afro-orange="1"] {
        background-color: rgb(251, 140, 60) !important;
        border-color: rgb(251, 140, 60) !important;
      }
      /* KOYU TEMA: dolu yeşil butonlar -> parlak yeşil */
      html.afro-wp.afro-dark [data-afro-orange="1"] {
        background-color: rgb(20, 182, 126) !important;
        border-color: rgb(20, 182, 126) !important;
      }
      
      /* HER İKİ MODDA TÜM YEŞİL YAZILARI/İKONLARI/KENARLIKLARI TURUNCU YAP */
      /* AÇIK TEMA: yeşiller -> turuncu */
      html.afro-wp.afro-light [data-afro-green-text="1"] {
        color: rgb(251, 140, 60) !important;
      }
      html.afro-wp.afro-light [data-afro-green-border="1"] {
        border-color: rgb(251, 140, 60) !important;
      }
      html.afro-wp.afro-light [data-afro-green-fill="1"] {
        fill: rgb(251, 140, 60) !important;
      }
      /* KOYU TEMA: yeşiller -> parlak yeşil (farklı ton) */
      html.afro-wp.afro-dark [data-afro-green-text="1"] {
        color: rgb(20, 182, 126) !important;
      }
      html.afro-wp.afro-dark [data-afro-green-border="1"] {
        border-color: rgb(20, 182, 126) !important;
      }
      html.afro-wp.afro-dark [data-afro-green-fill="1"] {
        fill: rgb(20, 182, 126) !important;
      }
      /* KOYU TEMA: uygulamanın KENDİ turuncu rengini (rgb(251,140,60))
         kullanan elemanları (aktif alt kategori çipi, "Siparişi Tamamla"
         çubuğu vb.) parlak yeşile çevir. Bunlar build'e özgü atomik css
         class'ları (.r-1s5ja4 vb.) olduğu için runtime taramayla işaretlenir. */
      html.afro-wp.afro-dark [data-afro-d2g~="bg"] {
        background-color: rgb(20, 182, 126) !important;
      }
      html.afro-wp.afro-dark [data-afro-d2g~="border"] {
        border-color: rgb(20, 182, 126) !important;
      }
      html.afro-wp.afro-dark [data-afro-d2g~="text"] {
        color: rgb(20, 182, 126) !important;
      }
      /* ==== AKSAN RENGİ BİRLEŞTİRME (STATİK - FLICKER YOK) ====
         Uygulama; turuncu ve yeşil aksan renklerini derlenmiş ATOMİK css
         class'larıyla uyguluyor (.r-1s5ja4 gibi). Bu class'ları doğrudan
         statik CSS ile ezersek renk HER render'da anında doğru olur; JS
         taramasının gecikmesinden kaynaklanan turuncu<->yeşil parlaması
         (flicker) tamamen ortadan kalkar.
         TEMA KURALI: AÇIK = turuncu rgb(251,140,60); KOYU = parlak yeşil
         rgb(20,182,126). NOT: build yenilenirse class adları değişebilir;
         JS tarayıcılar yedek olarak kalır. */

      /* -- Uygulamanın TURUNCU atomik class'ları -- */
      /* Açık tema: turuncu kalsın (uygulamanın kendi değeri zaten turuncu,
         ama farklı turuncu tonlarını -255,165,0 / 249,115,22- tek tona
         sabitlemek için açıkça yazıyoruz). */
      html.afro-wp.afro-light .r-1s5ja4,
      html.afro-wp.afro-light .r-u92y06 { background-color: rgb(251, 140, 60) !important; }
      html.afro-wp.afro-light .r-15tdvqa,
      html.afro-wp.afro-light .r-1ytj54j { color: rgb(251, 140, 60) !important; }
      html.afro-wp.afro-light .r-rs0cj0,
      html.afro-wp.afro-light .r-3nu3je { border-color: rgb(251, 140, 60) !important; }
      /* Koyu tema: turuncu -> parlak yeşil */
      html.afro-wp.afro-dark .r-1s5ja4,
      html.afro-wp.afro-dark .r-u92y06 { background-color: rgb(20, 182, 126) !important; }
      html.afro-wp.afro-dark .r-15tdvqa,
      html.afro-wp.afro-dark .r-1ytj54j { color: rgb(20, 182, 126) !important; }
      html.afro-wp.afro-dark .r-rs0cj0,
      html.afro-wp.afro-dark .r-3nu3je { border-color: rgb(20, 182, 126) !important; }

      /* -- INLINE STYLE ile gelen turuncu (SEPET uyarı yazıları) --
         "Minimum Sipariş Tutarı", "Kalan Tutar" ve "Sepetinizde teslimata
         uygun olmayan ürünler var." React'te style={{color: theme.orange}}
         şeklinde INLINE basılıyor; atomik class DEĞİL. JS boyayıcı (d2g) bunu
         yakalıyor ama rAF gecikmesiyle önce turuncu kare görünüp sonra yeşile
         dönüyordu -> flicker. Tarayıcı inline rengi "rgb(251, 140, 60)"
         biçiminde normalize eder; bu saf-CSS kuralı HER paint'te anında
         uygulanır, React re-render'ı bunu kaldıramaz -> flicker tamamen biter.
         Not: sadece color ezilir; inline turuncu arka planlı bir eleman olsa
         bile yalnız yazı rengini etkiler (güvenli). */
      html.afro-wp.afro-dark [style*="251, 140, 60"] { color: rgb(20, 182, 126) !important; }
      html.afro-wp.afro-dark [style*="251,140,60"]   { color: rgb(20, 182, 126) !important; }

      /* -- Uygulamanın YEŞİL atomik class'ları (20,182,126 / 37,211,102) -- */
      /* Açık tema: yeşil -> turuncu */
      html.afro-wp.afro-light .r-4bxdpc,
      html.afro-wp.afro-light .r-1t70e42 { background-color: rgb(251, 140, 60) !important; }
      html.afro-wp.afro-light .r-1oh7245 { color: rgb(251, 140, 60) !important; }
      html.afro-wp.afro-light .r-1syw04g { border-color: rgb(251, 140, 60) !important; }
      /* Koyu tema: uygulamanın yeşilini parlak yeşile (20,182,126) sabitle */
      html.afro-wp.afro-dark .r-4bxdpc,
      html.afro-wp.afro-dark .r-1t70e42 { background-color: rgb(20, 182, 126) !important; }
      html.afro-wp.afro-dark .r-1oh7245 { color: rgb(20, 182, 126) !important; }
      html.afro-wp.afro-dark .r-1syw04g { border-color: rgb(20, 182, 126) !important; }

      /* KULLANICI İSTEĞİ: AÇIK MODDA yükleniyor spinner'ı (yeşil daire)
         TURUNCU olsun. React ActivityIndicator merkez konumlu (cx=16 cy=16)
         svg circle'larını hedefler; tüm boyutlarda (r değeri farketmez) geçerli.
         Ürün ikonları farklı geometride (merkez offset) olduğu için etkilenmez.
         Koyu modda yeşil kalır. */
      html.afro-wp.afro-light svg circle[cx="16"][cy="16"] {
        stroke: rgb(251, 140, 60) !important;
      }
      html.afro-wp.afro-dark svg circle[cx="16"][cy="16"] {
        stroke: rgb(20, 182, 126) !important;
      }

      /* KULLANICI İSTEĞİ: SEPET SAYFASINDA turuncu dolu butonları ve sarımtırak
         kutuları ŞEFFAF BUZLU yap (içi boş outline style, arkadan duvar kağıdı
         görünsün). Buna dahil: "Pazardan Gel-Al", "Tezgahta Nakit/Pos" butonları,
         "Teslim Alma Saati" kutusu, "Ara Toplam" özet kutusu. Profil/ürünler
         sayfasındaki butonlar normal kalsın (sadece sepette uygula). */
      html.afro-wp.afro-light [data-afro-cart-outline="1"] {
        background-color: rgba(255, 255, 255, 0.65) !important;
        border: 2px solid rgb(251, 140, 60) !important;
        -webkit-backdrop-filter: blur(12px) saturate(1.2) !important;
        backdrop-filter: blur(12px) saturate(1.2) !important;
        color: rgb(251, 140, 60) !important;
      }
      /* KULLANICI İSTEĞİ: Sepette arka planı ŞEFFAF olup duvar kağıdı direkt
         geçtiği için yazısı okunmayan bloklara ŞEFFAF BUZLU-CAM panel ekle
         (renk yok; yarı şeffaf beyaz + güçlü blur, duvar kağıdı hafif geçsin).
         İki tip: (frost) = tam panel (şeffaf bare bloklar: Sipariş Tamamlama +
         üst başlık); (fill) = app'in zayıf beyaz kartlarına (özet/adres/
         mahalleler) güçlü blur ekleyip buzlu cam yap, köşe/padding'i korunur. */
      html.afro-wp.afro-light [data-afro-cart-frost="1"] {
        background-color: rgba(255, 255, 255, 0.5) !important;
        -webkit-backdrop-filter: blur(18px) saturate(1.25) !important;
        backdrop-filter: blur(18px) saturate(1.25) !important;
        border-radius: 12px !important;
        padding: 12px 14px !important;
      }
      html.afro-wp.afro-light [data-afro-cart-fill="1"] {
        background-color: rgba(255, 255, 255, 0.45) !important;
        -webkit-backdrop-filter: blur(18px) saturate(1.25) !important;
        backdrop-filter: blur(18px) saturate(1.25) !important;
      }
      /* Aktif teslimat/ödeme butonlarının (Eve Servis, Kapıda Nakit) iç yazısı
         BEYAZdı, açık buzlu zeminde okunmuyordu -> turuncuya çevir (okunur). */
      html.afro-wp.afro-light [data-afro-cart-outline="1"],
      html.afro-wp.afro-light [data-afro-cart-outline="1"] * {
        color: rgb(224, 108, 24) !important;
      }
      /* Üst başlık alt satırı ("X çeşit ürün • ₺..") soluk gri -> koyu okunur. */
      html.afro-wp.afro-light [data-afro-cart-darktext="1"],
      html.afro-wp.afro-light [data-afro-cart-darktext="1"] * {
        color: rgb(40, 62, 50) !important;
      }
      /* Sipariş Oluştur butonu -> YEŞİL (yazı beyaz, okunur). */
      html.afro-wp.afro-light [data-afro-order-btn="1"] {
        background-color: rgb(20, 182, 126) !important;
        border-color: rgb(20, 182, 126) !important;
        -webkit-backdrop-filter: none !important;
        backdrop-filter: none !important;
      }
      html.afro-wp.afro-light [data-afro-order-btn="1"] * {
        color: rgb(255, 255, 255) !important;
      }
      /* Alt menü çubuğu -> YÜZEN pill/ada: absolute konumla akıştan çıkar,
         böylece kaydırma kabı tüm yüksekliği kaplar ve içerik/butonlar pill'in
         ALTINDAN geçer (kesik bant kalkar). Her iki temada da geçerli konum. */
      html.afro-wp [data-afro-navpill="1"] {
        position: fixed !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 8px !important;
        width: calc(100% - 28px) !important;
        max-width: 470px !important;
        margin: 0 auto !important;
        border-radius: 32px !important;
        box-shadow: 0 8px 26px rgba(70, 35, 0, 0.28) !important;
        overflow: hidden !important;
        z-index: 40 !important;
      }
      /* AÇIK tema pill görünümü */
      html.afro-wp.afro-light [data-afro-navpill="1"] {
        border: 1.5px solid rgba(251, 140, 60, 0.6) !important;
        background-color: rgba(255, 255, 255, 0.28) !important;
        -webkit-backdrop-filter: blur(9px) saturate(1.2) !important;
        backdrop-filter: blur(9px) saturate(1.2) !important;
      }
      /* KOYU tema pill görünümü (koyu yarı-şeffaf zemin + YEŞİL kenar) */
      html.afro-wp.afro-dark [data-afro-navpill="1"] {
        border: 1.5px solid rgba(20, 182, 126, 0.6) !important;
        background-color: rgba(22, 22, 26, 0.34) !important;
        -webkit-backdrop-filter: blur(10px) saturate(1.2) !important;
        backdrop-filter: blur(10px) saturate(1.2) !important;
      }
      /* Kaydırma kabına alt boşluk: son satır pill'in altında kalmasın. */
      html.afro-wp [data-afro-navpad="1"] {
        padding-bottom: 120px !important;
        box-sizing: border-box !important;
      }
      /* Ürün sayfasındaki "Siparişi Tamamla" sepet çubuğu: yüzen pill ile
         çakışmasın diye YUKARI kaydır (pill'in ÜSTÜNE otursun). Ayrıca alt
         kategori kutuları gibi ŞEFFAF BUZLU + hafif doku (turuncu kimlik korunur,
         saydamlık korunur, yazı okunur kalsın diye gölge). */
      html.afro-wp [data-afro-cartbar="1"] {
        bottom: 84px !important;
        z-index: 41 !important;
        -webkit-backdrop-filter: blur(10px) saturate(1.2) !important;
        backdrop-filter: blur(10px) saturate(1.2) !important;
        border-radius: 16px !important;
      }
      html.afro-wp.afro-light [data-afro-cartbar="1"] {
        background-color: rgba(251, 140, 60, 0.34) !important;
        background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.12) 0px, rgba(255,255,255,0.12) 2px, rgba(255,255,255,0) 2px, rgba(255,255,255,0) 8px) !important;
        border: 1.5px solid rgba(251, 140, 60, 0.6) !important;
      }
      html.afro-wp.afro-dark [data-afro-cartbar="1"] {
        background-color: rgba(20, 182, 126, 0.34) !important;
        background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.12) 0px, rgba(255,255,255,0.12) 2px, rgba(255,255,255,0) 2px, rgba(255,255,255,0) 8px) !important;
        border: 1.5px solid rgba(20, 182, 126, 0.6) !important;
      }
      html.afro-wp [data-afro-cartbar="1"] * {
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45) !important;
      }
      /* MOBİL DÜZELTME: "Siparişi Tamamla" çubuğu absolute + kısa/kaydırılabilir
         kapsayıcı yüzünden içeriğin ortasına düşüp ürün kartlarının "Ekle"
         butonlarının üstüne biniyordu. Dar ekranda çubuğu VIEWPORT'a SABİTLE
         (fixed), alt menü pill'inin hemen üstüne otursun. Masaüstü etkilenmez. */
      @media (max-width: 768px) {
        html.afro-wp [data-afro-cartbar="1"] {
          position: fixed !important;
          left: 8px !important;
          right: 8px !important;
          width: auto !important;
          max-width: none !important;
          bottom: calc(80px + env(safe-area-inset-bottom, 0px)) !important;
        }
      }
      /* Üstteki bilgi kutucukları (Pazar saati / Gel-Al saati / minimum vb.):
         opak koyu yeşil yerine ŞEFFAF BUZLU CAM. Boyut korunur. Her iki tema. */
      html.afro-wp [data-afro-infochip="1"] {
        -webkit-backdrop-filter: blur(9px) saturate(1.2) !important;
        backdrop-filter: blur(9px) saturate(1.2) !important;
      }
      html.afro-wp.afro-light [data-afro-infochip="1"] {
        background-color: rgba(255, 255, 255, 0.34) !important;
        border-color: rgba(251, 140, 60, 0.5) !important;
      }
      html.afro-wp.afro-dark [data-afro-infochip="1"] {
        background-color: rgba(20, 22, 26, 0.32) !important;
        border-color: rgba(20, 182, 126, 0.55) !important;
      }
      /* "Çok al az öde" başlığı tıklanınca en üste kaydırır -> imleç işareti. */
      html.afro-wp [data-afro-scrolltop="1"] {
        cursor: pointer !important;
      }
      /* Profil/Ayarlar sayfasındaki opak kartları (menü satırları, bildirim,
         tema, hesap) ŞEFFAF BUZLU CAM yap ki duvar kağıdı arkadan görünsün. */
      html.afro-wp [data-afro-glasscard="1"] {
        -webkit-backdrop-filter: blur(16px) saturate(1.2) !important;
        backdrop-filter: blur(16px) saturate(1.2) !important;
        border-radius: 24px !important;
      }
      html.afro-wp.afro-light [data-afro-glasscard="1"] {
        background-color: rgba(255, 255, 255, 0.45) !important;
        border-color: rgba(251, 140, 60, 0.6) !important;
      }
      html.afro-wp.afro-dark [data-afro-glasscard="1"] {
        background-color: rgba(18, 20, 24, 0.42) !important;
        border-color: rgba(20, 182, 126, 0.55) !important;
      }

      /* REQ1: Ürünler/pazar sayfası ÜST BAŞLIK bloğu (market adı satırı) ->
         tam genişlikte ŞEFFAF BUZLU panel (yazı duvar kağıdı üstünde okunsun). */
      html.afro-wp [data-afro-headerpanel="1"] {
        border-radius: 16px !important;
        /* Dikey padding 8px -> 4px: panel daha kompakt olsun; native üst
