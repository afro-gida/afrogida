          card.appendChild(top); card.appendChild(body);
          m.appendChild(card);
          document.body.appendChild(m);

          // Bir ISO tarihten gün anahtarı (YYYY-MM-DD) çıkar
          function afroDayKey(iso) {
            if (!iso) return '';
            var s = String(iso);
            if (s.length >= 10 && s.charAt(4) === '-' && s.charAt(7) === '-') return s.slice(0, 10);
            try { var d = new Date(iso); return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
            catch (x) { return ''; }
          }
          // Gün anahtarını Türkçe okunur etikete çevir: "10 Ağustos 2026, Pazartesi"
          function afroDayLabel(key) {
            try {
              var p = key.split('-');
              var d = new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
              return d.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', weekday: 'long' });
            } catch (x) { return key; }
          }

          afroApi('/admin/supplier-sales?supplier=' + encodeURIComponent(supplierGroup))
            .then(function (data) {
              body.innerHTML = '';
              var allLog = data.log || [];

              // ---- Tarih filtre çubuğu ----
              var filterBar = document.createElement('div');
              filterBar.style.cssText = 'display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:14px 0 4px;';
              // Mevcut gün anahtarlarını topla (benzersiz, tarihe göre)
              var dayKeys = {};
              allLog.forEach(function (e) { var k = afroDayKey(e.date); if (k) dayKeys[k] = true; });
              var dayList = Object.keys(dayKeys).sort();

              var lbl = document.createElement('div');
              lbl.textContent = 'Gün seç:';
              lbl.style.cssText = 'color:#9ccbb8;font-size:13px;font-weight:700;';
              var dateInput = document.createElement('input');
              dateInput.type = 'date';
              dateInput.style.cssText = 'background:#03140d;color:#eafff4;border:1px solid #1b7d59;border-radius:9px;padding:8px 10px;font-size:13px;';
              // Not: min/max sınırı yok — satış olmayan günler (bugün dahil) de seçilebilir; seçilince "Seçili günde satış yok" gösterilir
              // Varsayılan olarak bugünün tarihi input'ta görünsün (ama filtreleme YOK, tümü gösterilecek)
              var today = new Date();
              dateInput.value = today.getFullYear() + '-' + ('0' + (today.getMonth() + 1)).slice(-2) + '-' + ('0' + today.getDate()).slice(-2);
              var allBtn = document.createElement('div');
              allBtn.textContent = 'Tümü';
              allBtn.style.cssText = 'background:#10b981;color:#fff;font-weight:800;font-size:13px;padding:8px 14px;border-radius:9px;cursor:pointer;';
              filterBar.appendChild(lbl); filterBar.appendChild(dateInput); filterBar.appendChild(allBtn);
              body.appendChild(filterBar);

              // ---- Özet + liste konteynerleri ----
              var sum = document.createElement('div');
              sum.style.cssText = 'display:flex;flex-wrap:wrap;gap:12px;margin:6px 0;';
              body.appendChild(sum);
              var listWrap = document.createElement('div');
              body.appendChild(listWrap);

              function chip(label, value, color) {
                var c = document.createElement('div');
                c.style.cssText = 'flex:1;min-width:150px;background:#03140d;border:1px solid #1b7d59;border-radius:12px;padding:12px 14px;';
                c.innerHTML = '<div style="color:#9ccbb8;font-size:12px;font-weight:700;">' + label + '</div>' +
                  '<div style="color:' + (color || '#eafff4') + ';font-size:19px;font-weight:900;margin-top:4px;">' + value + '</div>';
                return c;
              }

              // Bir sipariş kartını (ürün tablosuyla) oluştur
              function buildOrderCard(e) {
                var oc = document.createElement('div');
                oc.style.cssText = 'background:#03140d;border:1px solid ' + (e.refunded ? '#7f1d1d' : '#154b36') +
                  ';border-radius:12px;padding:12px 14px;margin-top:10px;';
                var oh = document.createElement('div');
                oh.style.cssText = 'display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px;';
                var dstr = '';
                try { dstr = new Date(e.date).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); } catch (x) { dstr = ''; }
                var oleft = document.createElement('div');
                oleft.innerHTML = '<div style="color:#e6f5ee;font-weight:800;font-size:13px;">' + (e.customer || 'Müşteri') +
                  '</div><div style="color:#8fe6c0;font-size:12px;">' + dstr +
                  (e.delivery_type ? ' • ' + (e.delivery_type === 'gel_al' ? 'Gel-Al' : 'Eve Servis') : '') + '</div>';
                var oright = document.createElement('div');
                oright.style.cssText = 'text-align:right;';
                if (e.refunded) {
                  oright.innerHTML = '<span style="display:inline-block;background:#7f1d1d;color:#fecaca;font-weight:800;font-size:11px;padding:4px 9px;border-radius:8px;">' +
                    (e.refund_label || 'İade edildi') + '</span>' +
                    '<div style="color:#f87171;font-weight:900;font-size:15px;margin-top:4px;text-decoration:line-through;">' + afroFmtTL(e.subtotal) + '</div>' +
                    '<div style="color:#34d399;font-weight:900;font-size:15px;">Net: ' + afroFmtTL(e.net) + '</div>';
                } else {
                  oright.innerHTML = '<div style="color:#34d399;font-weight:900;font-size:16px;">' + afroFmtTL(e.subtotal) + '</div>';
                }
                oh.appendChild(oleft); oh.appendChild(oright);
                oc.appendChild(oh);
                var tbl = document.createElement('table');
                tbl.style.cssText = 'width:100%;border-collapse:collapse;font-size:13px;';
                var thead = '<thead><tr>' +
                  '<th style="text-align:left;color:#9ccbb8;border-bottom:1px solid #154b36;padding:6px 4px;">Ürün</th>' +
                  '<th style="text-align:right;color:#9ccbb8;border-bottom:1px solid #154b36;padding:6px 4px;">Miktar</th>' +
                  '<th style="text-align:right;color:#9ccbb8;border-bottom:1px solid #154b36;padding:6px 4px;">Birim Fiyat</th>' +
                  '<th style="text-align:right;color:#9ccbb8;border-bottom:1px solid #154b36;padding:6px 4px;">Tutar</th>' +
                  '</tr></thead>';
                var tbody = '<tbody>';
                (e.items || []).forEach(function (it) {
                  var qtyStr = (Number(it.qty) || 0).toLocaleString('tr-TR') + (it.unit ? ' ' + it.unit : '');
                  tbody += '<tr>' +
                    '<td style="color:#e6f5ee;padding:6px 4px;border-bottom:1px solid #0d3325;">' + (it.name || 'Ürün') + '</td>' +
                    '<td style="color:#cdeee0;text-align:right;padding:6px 4px;border-bottom:1px solid #0d3325;">' + qtyStr + '</td>' +
                    '<td style="color:#cdeee0;text-align:right;padding:6px 4px;border-bottom:1px solid #0d3325;">' + afroFmtTL(it.price) + '</td>' +
                    '<td style="color:#e6f5ee;text-align:right;font-weight:700;padding:6px 4px;border-bottom:1px solid #0d3325;">' + afroFmtTL(it.line_total) + '</td>' +
                    '</tr>';
                });
                tbody += '</tbody>';
                tbl.innerHTML = thead + tbody;
                oc.appendChild(tbl);
                return oc;
              }

              // Seçili güne (veya tümüne) göre özet + günlük gruplu liste çiz
              function render(filterKey) {
                var shown = filterKey ? allLog.filter(function (e) { return afroDayKey(e.date) === filterKey; }) : allLog;
                // Özetleri filtrelenmiş kümeden hesapla
                var gross = 0, refund = 0, net = 0;
                shown.forEach(function (e) {
                  gross += Number(e.subtotal) || 0;
                  refund += Number(e.refunded_amount) || 0;
                  net += Number(e.net) || 0;
                });
                sum.innerHTML = '';
                sum.appendChild(chip(filterKey ? 'Net (Seçili Gün)' : 'Net Toplanan Tutar', afroFmtTL(net), '#34d399'));
                sum.appendChild(chip('Brüt Satış', afroFmtTL(gross), '#eafff4'));
                sum.appendChild(chip('Toplam İade', afroFmtTL(refund), '#f87171'));
                sum.appendChild(chip('Satış Sayısı', String(shown.length), '#eafff4'));

                listWrap.innerHTML = '';
                if (!shown.length) {
                  var empty = document.createElement('div');
                  empty.style.cssText = 'color:#9ccbb8;padding:24px 0;font-size:14px;';
                  empty.textContent = filterKey ? 'Seçili günde satış yok.' : 'Bu tedarikçi için henüz teslim edilmiş (satılan) sipariş yok.';
                  listWrap.appendChild(empty);
                  return;
                }
                // Güne göre grupla (yeni gün en üstte)
                var groups = {};
                shown.forEach(function (e) { var k = afroDayKey(e.date); (groups[k] = groups[k] || []).push(e); });
                var keys = Object.keys(groups).sort().reverse();
                keys.forEach(function (k) {
                  var entries = groups[k];
                  // Gün toplamları
                  var dNet = 0, dCount = entries.length;
                  entries.forEach(function (e) { dNet += Number(e.net) || 0; });
                  // Gün başlığı
                  var head = document.createElement('div');
                  head.style.cssText = 'display:flex;justify-content:space-between;align-items:center;gap:8px;margin:20px 0 2px;padding-bottom:6px;border-bottom:2px solid #1b7d59;';
                  head.innerHTML = '<div style="color:#8fe6c0;font-weight:900;font-size:15px;">' + afroDayLabel(k) + '</div>' +
                    '<div style="color:#34d399;font-weight:900;font-size:14px;">' + afroFmtTL(dNet) + ' • ' + dCount + ' satış</div>';
                  listWrap.appendChild(head);
                  entries.forEach(function (e) { listWrap.appendChild(buildOrderCard(e)); });
                });
              }

              dateInput.onchange = function () { render(dateInput.value || null); };
              allBtn.onclick = function () { render(null); }; // "Tümü" -> hepsi (tarih kutusu bugünde kalır)

              render(dateInput.value || null); // başlangıçta SEÇİLİ GÜNE (bugüne) göre filtreli
            })
            .catch(function (err) {
              body.innerHTML = '<div style="color:#f87171;padding:20px 0;">Satış logu alınamadı: ' + ((err && err.message) || '') + '</div>';
            });
        }
        function afroSupRemove(u, btn) {
          if (!window.confirm((u.name || u.phone || 'Bu kişi') + ' için tedarikçi yetkisi kaldırılsın mı?')) return;
          btn.textContent = '...'; btn.style.opacity = '0.6';
          afroApi('/admin/staff/assign', { method: 'POST', body: { identifier: u.user_id, supplier_group: null } })
            .then(function () { afroSupLoad(); })
            .catch(function (e) {
              btn.textContent = 'Kaldır'; btn.style.opacity = '1';
              window.alert('Kaldırılamadı: ' + ((e && e.message) || ''));
            });
        }
        function afroSupplierPanel() {
          var input = document.querySelector('input[placeholder*="user_id"]');
          if (!input) { afroSupCleanup(); return; }   // modal kapalı
          var col = input.parentNode;
          if (!col) return;
          var wrap = document.getElementById('afro-sup-wrap');
          if (!wrap) {
            wrap = document.createElement('div');
            wrap.id = 'afro-sup-wrap';
            wrap.style.cssText = 'margin-top:14px;border-top:1px solid rgba(255,255,255,0.12);padding-top:12px;';
            wrap.innerHTML = '<div style="color:#e6f5ee;font-weight:800;font-size:14px;margin-bottom:8px;">Atanmış Tedarikçiler</div>'
              + '<div id="afro-sup-list" style="display:flex;flex-direction:column;gap:8px;">'
              + '<div style="color:#9fb3aa;font-size:13px;">Yükleniyor...</div></div>';
            col.appendChild(wrap);
            afroSupLoad();
          } else if (wrap.parentNode !== col) {
            col.appendChild(wrap); // React kaldırdıysa geri koy
          }
        }

        // ============================================================
        // TEDARİKÇİ DETAY SAYFASI: Satış Logu butonu ekle, hesaba ata butonunu gizle
        // Screenshot'taki mobil tedarikçi detay ekranı için
        // ============================================================
        // Bir div'in SADECE kendi doğrudan text node'larını döndürür (çocuklar hariç)
        function afroDirectText(el) {
          var d = '';
          for (var n = 0; n < el.childNodes.length; n++) {
            if (el.childNodes[n].nodeType === 3) d += el.childNodes[n].nodeValue;
          }
          return d.trim();
        }
        function afroSupplierDetailPanel() {
          var logBtnId = 'afro-supplier-detail-saleslog-btn';
          // 1) "Bu tedarikçiyi hesaba ata" metnini taşıyan div'i bul
          //    (React Native Web: <div class="css-...">, role/button yok)
          var textDiv = null;
          var divs = document.querySelectorAll('div');
          for (var i = 0; i < divs.length; i++) {
            if (afroDirectText(divs[i]) === 'Bu tedarikçiyi hesaba ata') { textDiv = divs[i]; break; }
          }
          if (!textDiv) {
            // Tedarikçi detay sayfasında DEĞİLİZ. SPA'da başka sayfaya geçildiğinde
            // React bizim eklediğimiz butonu temizlemez -> elle kaldır ki başka
            // sayfalara (Pazarlar vb.) sızmasın.
            var leaked = document.getElementById(logBtnId);
            if (leaked && leaked.parentNode) leaked.parentNode.removeChild(leaked);
            return;
          }

          // 2) Tıklanabilir buton kutusunu bul (r-1loqt21 = RN Web pressable) ve gizle.
          //    Her tick'te tekrar gizle (React yeniden render edip geri getirebilir).
          var btnBox = textDiv;
          for (var k = 0; k < 5 && btnBox; k++) {
            if ((btnBox.className || '').toString().indexOf('r-1loqt21') >= 0) break;
            btnBox = btnBox.parentElement;
          }
          if (!btnBox) btnBox = textDiv.parentElement;
          if (btnBox && btnBox.style.display !== 'none') btnBox.style.display = 'none';

          // 3) Tedarikçi adını bul: "Tedarikçi Detayı" etiketinin hemen sonraki kardeşi
          var supplierName = '';
          for (var j = 0; j < divs.length; j++) {
            if (afroDirectText(divs[j]).toLocaleLowerCase('tr-TR') === 'tedarikçi detayı') {
              var sib = divs[j].nextElementSibling;
              if (sib) supplierName = (sib.textContent || '').trim();
              break;
            }
          }
          // Yedek: kalın (fw>=800), tepede ve "bağlı ürün" içermeyen metni ad kabul et
          if (!supplierName) {
            for (var m = 0; m < divs.length; m++) {
              var el = divs[m];
              var r = el.getBoundingClientRect();
              if (r.top > 0 && r.top < 140) {
                var dt = afroDirectText(el);
                var fw = parseInt(getComputedStyle(el).fontWeight, 10) || 400;
                if (dt && fw >= 800 && dt.toLocaleLowerCase('tr-TR') !== 'tedarikçi detayı' &&
                    dt.indexOf('bağlı ürün') < 0 && dt.length > 1 && dt.length < 60) {
                  supplierName = dt; break;
                }
              }
            }
          }

          // 4) "Satış Logları" butonunu ekle (yoksa). React sildiyse tekrar eklenir.
          if (document.getElementById(logBtnId)) return; // zaten ekranda

          var logBtn = document.createElement('div');
          logBtn.id = logBtnId;
          logBtn.textContent = '📊 Satış Logları';
          // "Ürün Ekle" butonuyla aynı boyut/stil: yan boşluk 24px (daha dar), padding 12px 0, aynı yeşil
          logBtn.style.cssText = 'display:flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;background:#14b67e;color:#fff;font-weight:700;font-size:16px;padding:12px 0;border-radius:12px;cursor:pointer;margin:8px 24px 0;';
          logBtn.onclick = function () {
            if (!supplierName) { window.alert('Tedarikçi adı bulunamadı.'); return; }
            afroOpenSalesLog(supplierName);
          };

          // "Bu tedarikçiyi hesaba ata" kutusunun bulunduğu yere (Ürün Ekle'nin altına) ekle
          if (btnBox && btnBox.parentNode) {
            btnBox.parentNode.insertBefore(logBtn, btnBox.nextSibling);
          } else if (textDiv.parentNode) {
            textDiv.parentNode.appendChild(logBtn);
          }
        }

        function tick() {
          var isCustomer = isCustomerSection();
          var isDark = isDarkActive();
          var active = isCustomer; // her iki temada da duvar kağıdı göster (müşteri kısmında)

          if (active) {
            if (!htmlEl.classList.contains('afro-wp')) htmlEl.classList.add('afro-wp');
            // tema sınıflarını ekle
            if (isDark) {
              htmlEl.classList.add('afro-dark');
              htmlEl.classList.remove('afro-light');
            } else {
              htmlEl.classList.add('afro-light');
              htmlEl.classList.remove('afro-dark');
            }
            paintPageLayers();
            // buzlu cam + turuncu butonlar/yazılar sadece AÇIK modda uygulanır
            if (isDark) {
              unpaintGlassOnly();
              clearNavDark(); // koyu modda kategori/saat bantlarını şeffaflaştır
              // KOYU TEMA: yeşil renk korunur (turuncu dönüşüm yok)
              paintNavPill(); // alt menü çubuğu koyu modda da yüzen pill/ada
              paintCartBar(); // "Siparişi Tamamla" çubuğunu pill'in üstüne kaydır
              paintInfoChips(); // üst bilgi kutucukları şeffaf buzlu cam (koyu)
              wireScrollTop(); // "Çok al az öde" -> en üste kaydır
              paintGlassCards(); // profil/ayarlar opak kartları şeffaf buzlu (koyu)
              paintInfoRowPanel(); // BİLGİ KUTUCUKLARI satırına tam genişlikte buzlu panel
              paintMgrCard(); // profil isim/yönetici kartı şeffaf buzlu
              paintCartSummary(); // sepet Toplam/özet kutusu şeffaf buzlu
              clearCatChipFill(); // seçili olmayan kategori çip dolgusu şeffaf
              padSubCatStrip(); // alt kategori çipi şeridin üstüne yapışmasın
              fixDarkOrangeToGreen(); // uygulamanın kendi turuncularını parlak yeşile çevir
              paintSectionBands(); // bölüm başlığı bantları: stabil buzlu zemin + yeşil kenarlık
            } else {
              paintGlassLayers();
              clearNavGlass(); // kategori/saat butonlarının arkasındaki geniş buzlu bandı kaldır
              paintOrangeButtons();
              paintGreenTextsOrange();
              paintMapIframe(true); // açık modda harita butonu TURUNCU
              paintCartOutline(); // sepet sayfasında turuncu butonları şeffaf-buzlu yap
              paintCartFrost(); // şeffaf kalıp yazısı okunmayan bloklara buzlu-cam panel
              paintNavPill(); // alt menü çubuğunu yüzen pill/ada yap
              paintNavIcons(); // pasif tab ikonları/etiketleri mat turuncu
              paintCartBar(); // "Siparişi Tamamla" çubuğunu pill'in üstüne kaydır
              paintInfoChips(); // üst bilgi kutucukları şeffaf buzlu cam (açık)
              wireScrollTop(); // "Çok al az öde" -> en üste kaydır
              paintGlassCards(); // profil/ayarlar kartlarına buzlu cam (açık)
              paintInfoRowPanel(); // BİLGİ KUTUCUKLARI satırına tam genişlikte buzlu panel
              paintMgrCard(); // profil isim/yönetici kartı şeffaf buzlu
              paintCartSummary(); // sepet Toplam/özet kutusu şeffaf buzlu
              unpaintSubCatGreen(); // AÇIK tema: alt kategoriler TURUNCU kalsın
              clearCatChipFill(); // kategori bandı chipleri şeffaf (seçili hariç)
              padSubCatStrip(); // alt kategori çipi şeridin üstüne yapışmasın
              unfixDarkOrange(); // açık temada koyu-tema turuncu->yeşil işaretlerini temizle
              paintSectionBands(); // bölüm başlığı bantları: stabil buzlu zemin + turuncu kenarlık
            }
          } else {
            if (htmlEl.classList.contains('afro-wp')) htmlEl.classList.remove('afro-wp');
            htmlEl.classList.remove('afro-dark', 'afro-light');
            unpaint();
          }

          // ADMIN bölümü: "Tedarikçi Yetkilendir" penceresi açıksa atanmış
          // tedarikçi listesini (isim+telefon) ve Kaldır butonlarını enjekte et.
          // Ayrıca tedarikçi detay sayfasına Satış Logu butonu ekle.
          // (Müşteri tarafında modal olmaz; orada sadece temizlik yaparız.)
          try {
            if (!isCustomer) {
              afroSupplierPanel();
              afroSupplierDetailPanel();
            } else {
              afroSupCleanup();
            }
          } catch (e) { /* sessizce geç */ }

          // MÜŞTERİ tarafı: Profil sayfasındaki "Şikayet ve Öneri" butonuna
          // tıklanınca WhatsApp iletişim modalı aç.
          try {
            afroComplaintWhatsApp();
          } catch (e) { /* sessizce */ }
        }

        // rota değişiminde/DOM güncellemesinde ANINDA boya (600ms boşluğu kapat)
        var rafPending = false;
        function scheduleTick() {
          if (rafPending) return;
          rafPending = true;
          requestAnimationFrame(function () { rafPending = false; tick(); });
        }

        tick();
        setInterval(tick, 600);
        window.addEventListener('resize', tick);
        // KAYDIRMA sırasında ANINDA yeniden boya. React iç scroll container'da
        // kaydırınca çipleri yeniden çiziyor; capture=true ile o iç kaydırmaları
        // da yakalarız. rAF ile throttle -> uygulamanın turuncu/yeşil arası
        // KISA PARLAMASI (flicker) neredeyse görünmez olur.
        window.addEventListener('scroll', scheduleTick, { passive: true, capture: true });

        // DOM her değiştiğinde (sayfa geçişi = yeni katmanlar) hemen boya.
        // ÖNEMLİ: Modallar/popuplar (Şikayet & Öneri, "Evlere Servisimiz Olan
        // Mahalleler" vb.) #root DIŞINDA ayrı bir PORTAL katmanına render edilir.
        // Bu yüzden yalnızca #root'u izlersek modal açılışını KAÇIRIRIZ ve boyama
        // ancak 600ms'lik periyodik tick'te yapılır -> mahalle çiplerinin yeşilden
        // beyaz-cama geçişi ~500ms GÖRÜNÜR (flash). Çözüm: document.body'yi izle,
        // böylece portal katmanı eklenince ANINDA boyanır (flash olmaz).
        // NOT: setAttribute(GLASS_ATTR) yalnızca ATTRIBUTE değiştirir; observer
        // childList/subtree (node ekle/çıkar) izlediği için sonsuz döngü OLMAZ.
        try {
          var mo = new MutationObserver(scheduleTick);
          var startObserve = function () {
            var body = document.body;
            if (body) mo.observe(body, { childList: true, subtree: true });
            else setTimeout(startObserve, 100);
          };
          startObserve();
        } catch (e) {}

        // SPA rota değişimlerini de yakala
        try {
          var _ps = history.pushState;
          history.pushState = function () { _ps.apply(this, arguments); scheduleTick(); };
          var _rs = history.replaceState;
          history.replaceState = function () { _rs.apply(this, arguments); scheduleTick(); };
          window.addEventListener('popstate', scheduleTick);
        } catch (e) {}
      })();
    </script>

    <!-- ================================================================
         ÜRÜN SEÇİM PANELİ MODÜLÜ (afro_panel_module.js)
         ================================================================ -->
    <script>
/* ================================================================
   ÜRÜN SEÇİM PANELİ (Getir/Yemeksepeti tarzı alt-sayfa / bottom-sheet)
   ----------------------------------------------------------------
   AMAÇ: Bir ürüne tıklanınca eskiden /product/{id} BİLGİ sayfasına
   gidiliyordu (sadece fiyat + üretici notu; seçim/sepet yok). Bunun
   yerine sayfanın ÜSTÜNDE bir panel açılır:
     - adet seçimi (Kg -> 0.5 adım, adet -> 1 adım)
     - özelleştirilebilir üründe malzeme/seçenek grupları + not
     - "Sepete Ekle" butonu
   ----------------------------------------------------------------
   MİMARİ (derlenmiş Expo bundle'a müdahale edemediğimiz için):
   * ADET: uygulamanın KENDİ "Ekle"/"+"/"-" butonları programatik
     tıklanır. Böylece React state (G) + alt "Siparişi Tamamla"
     çubuğu doğru güncellenir, sepet/afro_basket tutarlı kalır.
   * ÖZELLEŞTİRME: uygulamanın CSel state'ine yazamadığımız için
     seçimler 'afro_custom' localStorage anahtarına yazılır; sipariş
     POST /api/orders isteği araya girilip her item'a selected_options
     + note enjekte edilir. Backend fiyatı ÜRÜN TANIMINDAN yeniden
     hesapladığı için (client'a güvenmiyor) para açısından güvenlidir.
   ================================================================ */
(function () {
  if (window.__afroPanel) return;
  window.__afroPanel = 1;

  var CUSTOM_KEY = 'afro_custom';
  var BASKET_KEY = 'afro_basket';

  /* ---------- yardımcılar ---------- */
  function jget(k, d) { try { var v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch (e) { return d; } }
  function jset(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
  function basket() { return jget(BASKET_KEY, {}) || {}; }
  function customs() { return jget(CUSTOM_KEY, {}) || {}; }
  function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
  function isDark() { try { return document.documentElement.classList.contains('afro-dark'); } catch (e) { return false; } }
  function accent() { return isDark() ? 'rgb(20,182,126)' : 'rgb(251,140,60)'; }
  function stepFor(unit) { return /kg/i.test(String(unit || '')) ? 0.5 : 1; }
  function fmtTL(n) {
    try { return new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(Number(n || 0)); }
    catch (e) { return Number(n || 0).toFixed(2); }
  }
  function fmtQty(n) { var s = (Math.round(Number(n) * 100) / 100).toString(); return s; }
  function basePrice(p) { return Number((p && (p.price != null ? p.price : (p.gel_al_price != null ? p.gel_al_price : p.eve_servis_price))) || 0); }

  /* ---------- ürün önbelleği ---------- */
  window.__afroProducts = window.__afroProducts || {};   // id -> product
  function cacheProducts(arr) {
    if (!Array.isArray(arr)) return;
    arr.forEach(function (p) { if (p && p.id) window.__afroProducts[p.id] = p; });
  }
  function productNames() {
    var s = {};
    Object.keys(window.__afroProducts).forEach(function (id) {
      var n = (window.__afroProducts[id].name || '').trim();
      if (n) s[n] = id;
    });
    return s;
  }
  async function ensureProducts() {
    if (Object.keys(window.__afroProducts).length) return;
    try {
      var tok = localStorage.getItem('pazar_session_token');
      var mkt = localStorage.getItem('selected_market_name') || '';
      var r = await fetch(location.origin + '/api/products' + (mkt ? ('?market=' + encodeURIComponent(mkt)) : ''),
        { headers: tok ? { Authorization: 'Bearer ' + tok } : {} });
      var j = await r.json();
      cacheProducts(Array.isArray(j) ? j : (j.products || j.items || []));
    } catch (e) {}
  }

  /* ================================================================
     FETCH SARMALAYICI: (a) ürün listelerini önbelleğe al,
     (b) sipariş POST'una özelleştirmeleri enjekte et.
     ================================================================ */
  (function () {
    var prev = window.fetch;
    if (typeof prev !== 'function') return;
    function urlOf(input) { try { return typeof input === 'string' ? input : (input && input.url) || ''; } catch (e) { return ''; } }

    window.fetch = function (input, init) {
      var url = urlOf(input);
      var method = (init && init.method ? init.method : (input && input.method) || 'GET').toString().toUpperCase();

      // (b) SİPARİŞ: POST /api/orders VE /api/payments/init -> item'lara
      //     afro_basket (adet) + afro_custom (seçenek/not) enjekte et.
      //     Sepet çubuğu gerçekte /payments/init kullanıyor; qty native G'den,
      //     selected_options native CSel'den geliyordu -> bizim panelimizin
      //     seçimleri faturaya HİÇ yansımıyordu. Artık afro_basket+afro_custom
      //     TEK doğruluk kaynağı; backend fee'yi üründen yeniden hesaplar (güvenli).
      try {
        if (method === 'POST' && /\/api\/(orders|payments\/init)(\?|$)/.test(url) && !/\/admin\//.test(url) && init && typeof init.body === 'string') {
          var body = JSON.parse(init.body);
          var items = body.items || body.cart_items;
          if (Array.isArray(items)) {
            var cs = customs();
            var bk = basket();
            items.forEach(function (it) {
              var id = it && (it.id || it.product_id);
              if (!id) return;
              // Adet: afro_basket yetkili (panelde değiştirilen adet native G
              // stale kalsa bile doğru tahsil edilsin).
              if (bk[id] != null && Number(bk[id]) > 0) { it.qty = Number(bk[id]); it.quantity = Number(bk[id]); }
              // Seçenek/not: afro_custom yetkili (panel native editörü değiştirir).
              var c = cs[id];
              if (c) {
                it.selected_options = (c.selected_options && c.selected_options.length) ? c.selected_options : [];
                if (c.note && c.note.trim()) { it.note = c.note; it.customization_note = c.note; }
              }
            });
            init = Object.assign({}, init, { body: JSON.stringify(body) });
          }
        }
      } catch (e) { /* sipariş enjeksiyonu hata verirse orijinal gövde gider */ }

      var p = prev.call(this, input, init);

      // (a) ürün listesi yanıtını önbelleğe al
      try {
        if (method === 'GET' && /\/api\/products(\?|$)/.test(url) && !/\/products\/[^?]/.test(url)) {
          p.then(function (resp) {
            try {
              resp.clone().json().then(function (j) {
                cacheProducts(Array.isArray(j) ? j : (j && (j.products || j.items)) || []);
              }).catch(function () {});
            } catch (e) {}
          }).catch(function () {});
        }
        // sipariş başarılıysa özelleştirmeleri temizle
        if (method === 'POST' && /\/api\/(orders|payments\/init)(\?|$)/.test(url) && !/\/admin\//.test(url)) {
          p.then(function (resp) { try { if (resp && resp.ok) localStorage.removeItem(CUSTOM_KEY); } catch (e) {} }).catch(function () {});
        }
      } catch (e) {}

      return p;
    };
  })();

  /* ================================================================
     NATİF ADET SÜRÜCÜSÜ: ürün kartındaki uygulamanın kendi
     "Ekle"/"+"/"-" butonlarını bulup programatik tıklar.
     ================================================================ */
  function fireClick(el) {
    if (!el) return false;
    var r = el.getBoundingClientRect();
    var o = { bubbles: true, cancelable: true, clientX: r.left + r.width / 2, clientY: r.top + r.height / 2, button: 0, pointerId: 1, pointerType: 'mouse' };
    try { el.dispatchEvent(new PointerEvent('pointerdown', o)); } catch (e) {}
    try { el.dispatchEvent(new PointerEvent('pointerup', o)); } catch (e) {}
    try { el.dispatchEvent(new MouseEvent('mousedown', o)); } catch (e) {}
    try { el.dispatchEvent(new MouseEvent('mouseup', o)); } catch (e) {}
    try { el.dispatchEvent(new MouseEvent('click', o)); } catch (e) {}
    return true;
  }
  // Kart içindeki "Ekle" butonu (henüz sepette olmayan ürün).
  function ekleBtn(card) {
    return Array.prototype.slice.call(card.querySelectorAll('*')).filter(function (e) {
      var t = (e.innerText || '').replace(/\s+/g, ' ').trim();
      return /Ekle$/.test(t) && t.length < 12;
    }).sort(function (a, b) { return a.querySelectorAll('*').length - b.querySelectorAll('*').length; })[0] || null;
  }
  // Stepper'ın DIŞ yuvarlak −/+ butonları (soldan sağa: [−, +]).
  function roundBtns(card) {
    return Array.prototype.slice.call(card.querySelectorAll('*')).filter(function (e) {
      var r = e.getBoundingClientRect(); var cs;
      try { cs = getComputedStyle(e); } catch (x) { return false; }
      var br = parseFloat(cs.borderTopLeftRadius) || 0;
      return r.width >= 30 && r.width <= 60 && r.height >= 30 && r.height <= 60 && br >= 12 && cs.cursor === 'pointer';
    }).sort(function (a, b) { return a.getBoundingClientRect().left - b.getBoundingClientRect().left; });
  }
  // Kartın GÖRÜNEN adedini oku (React state'in doğru yansıması; afro_basket
  // gecikmesine güvenmeyiz). "Ekle" görünüyorsa 0.
  function getNativeQty(card) {
    var e = ekleBtn(card);
    if (e && e.offsetParent !== null) return 0;
    var btns = roundBtns(card);
    if (btns.length < 2) return 0;
    var lx = btns[0].getBoundingClientRect().right;
    var rx = btns[btns.length - 1].getBoundingClientRect().left;
    var val = 0;
    Array.prototype.slice.call(card.querySelectorAll('*')).forEach(function (n) {
      if (n.children.length) return;
      var t = (n.textContent || '').trim();
      if (/^[0-9]+([.,][0-9]+)?$/.test(t)) {
        var cr = n.getBoundingClientRect(); var cx = cr.left + cr.width / 2;
        if (cx > lx - 4 && cx < rx + 4) val = parseFloat(t.replace(',', '.'));
      }
    });
    return val;
  }
  async function setNativeQty(card, id, unit, target) {
    if (!card) return 0;
    var guard = 0;
    if (getNativeQty(card) === 0 && target > 0) {
      var ek = ekleBtn(card);
      if (ek) { fireClick(ek); await wait(320); }
    }
    while (Math.abs(getNativeQty(card) - target) > 1e-6 && guard++ < 40) {
      var c = getNativeQty(card);
      var b = roundBtns(card);
      if (b.length < 2) break;
      var btn = c < target ? b[b.length - 1] : b[0];
      fireClick(btn);
      await wait(280);
      if (getNativeQty(card) === c) { await wait(300); if (getNativeQty(card) === c) break; } // ilerleme yok -> dur
    }
    return getNativeQty(card);
  }

  /* ================================================================
     SEPET STEPPER SÜRÜCÜSÜ: sepet satırındaki adet göstergesi bir DÜZ
     SAYI yaprağı; −/+ butonları ise ikon-glyph (cursor:pointer) elemanlar.
     roundBtns() bunları bulamıyordu (genişlik/köşe kriteri tutmuyor); bu
     yüzden setNativeQty sepette çalışmıyor, adet native yeniden-çizime
     kadar (~3-4sn) gecikiyordu. Aşağıdaki bulucu sayı yaprağını ve onu
     saran −/+ pointer elemanlarını konuma göre bulur -> sentetik tık ile
     uygulamanın KENDİ state'ini anında sürer (kanıtlandı: tık -> afro_basket
     ve ara toplam anında güncelleniyor, kampanya indirimi native uygulanıyor).
     ================================================================ */
  function cartStepper(row) {
    if (!row) return null;
    var leaves = Array.prototype.slice.call(row.querySelectorAll('*')).filter(function (e) {
      return e.children.length === 0 && (e.textContent || '').trim();
    });
    var numLeaf = null;
    for (var i = 0; i < leaves.length; i++) {
      if (/^[0-9]+([.,][0-9]+)?$/.test((leaves[i].textContent || '').trim())) { numLeaf = leaves[i]; break; }
    }
    if (!numLeaf) return null;
    var nr = numLeaf.getBoundingClientRect();
    var pointers = Array.prototype.slice.call(row.querySelectorAll('*')).filter(function (e) {
      if (e.children.length > 1) return false;
      try { return getComputedStyle(e).cursor === 'pointer'; } catch (x) { return false; }
    });
    var minus = pointers.filter(function (e) { return e.getBoundingClientRect().right <= nr.left + 3; })
      .sort(function (a, b) { return b.getBoundingClientRect().left - a.getBoundingClientRect().left; })[0] || null;
    var plus = pointers.filter(function (e) { return e.getBoundingClientRect().left >= nr.right - 3; })
      .sort(function (a, b) { return a.getBoundingClientRect().left - b.getBoundingClientRect().left; })[0] || null;
    return { numLeaf: numLeaf, minus: minus, plus: plus, val: parseFloat((numLeaf.textContent || '').replace(',', '.')) };
  }
  // Sepet satırındaki native adedi hedefe sür (uygulamanın kendi +/- tıklanır).
  async function setCartQty(row, unit, target) {
    var guard = 0, st = cartStepper(row);
    while (st && Math.abs(st.val - target) > 1e-6 && guard++ < 60) {
      var btn = st.val < target ? st.plus : st.minus;
      if (!btn) break;
      fireClick(btn);
      await wait(120);
      var nv = cartStepper(row);
      if (!nv || nv.val === st.val) { await wait(220); nv = cartStepper(row); if (!nv || nv.val === st.val) break; }
      st = nv;
    }
    return st ? st.val : null;
  }

  /* ================================================================
     KART TESPİTİ: tıklanan ürün kartını ve ürünü çöz.
     ================================================================ */
  function findCard(node) {
    var n = node, names = productNames();
    for (var k = 0; k < 14 && n && n !== document.body; k++) {
      if (n.nodeType === 1) {
        var r = n.getBoundingClientRect();
        var t = (n.innerText || '');
        if (r.width >= 130 && r.width <= 340 && r.height >= 140 && r.height <= 360 && /₺/.test(t)) {
          // ürün adını bul (DOM sırasında ilk eşleşen ad = ürün, sonrası tedarikçi)
          var pid = matchProduct(n, names);
          if (pid) return { card: n, id: pid };
        }
      }
      n = n.parentElement;
    }
    return null;
  }
  function matchProduct(card, names) {
    var leaves = Array.prototype.slice.call(card.querySelectorAll('*')).filter(function (e) {
      return e.children.length === 0 && (e.textContent || '').trim();
    });
    for (var i = 0; i < leaves.length; i++) {
      var txt = (leaves[i].textContent || '').trim();
      if (names[txt] != null) return names[txt];
    }
    return null;
  }
  // Tıklama kartın hangi bölgesinde? 'control' (Ekle/stepper) mı 'body' mi?
  function regionOf(card, ev) {
    var r = card.getBoundingClientRect();
    // alt ~64px kontrol şeridi
    return (ev.clientY >= r.bottom - 66) ? 'control' : 'body';
  }

  /* ================================================================
     PANEL (bottom-sheet) DOM'u
     ================================================================ */
  var el = {};
  function buildPanel() {
    if (el.wrap) return;
    var wrap = document.createElement('div');
    wrap.id = 'afroPanelWrap';
    wrap.setAttribute('data-afro-panel', '1');
    wrap.innerHTML =
      '<div class="afroPanelBackdrop"></div>' +
      '<div class="afroPanelSheet" role="dialog" aria-modal="true">' +
        '<div class="afroPanelHandle"></div>' +
        '<button class="afroPanelClose" aria-label="Kapat">\u2715</button>' +
        '<div class="afroPanelBody"></div>' +
        '<div class="afroPanelFooter">' +
          '<div class="afroQty">' +
            '<button class="afroQtyBtn afroQtyMinus" aria-label="Azalt">\u2212</button>' +
            '<span class="afroQtyVal">1</span>' +
            '<button class="afroQtyBtn afroQtyPlus" aria-label="Artır">+</button>' +
          '</div>' +
          '<button class="afroAddBtn">Sepete Ekle</button>' +
        '</div>' +
      '</div>';
    document.body.appendChild(wrap);
    el.wrap = wrap;
    el.backdrop = wrap.querySelector('.afroPanelBackdrop');
    el.sheet = wrap.querySelector('.afroPanelSheet');
    el.body = wrap.querySelector('.afroPanelBody');
    el.close = wrap.querySelector('.afroPanelClose');
    el.qtyVal = wrap.querySelector('.afroQtyVal');
    el.minus = wrap.querySelector('.afroQtyMinus');
    el.plus = wrap.querySelector('.afroQtyPlus');
    el.add = wrap.querySelector('.afroAddBtn');

    el.backdrop.addEventListener('click', closePanel);
    el.close.addEventListener('click', closePanel);
    el.minus.addEventListener('click', function () { changeQty(-1); });
    el.plus.addEventListener('click', function () { changeQty(1); });
    el.add.addEventListener('click', commit);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && el.wrap && el.wrap.classList.contains('open')) closePanel(); });
  }

  var state = null; // {product, qty, step, sel:{title->choice}, note}

  function closePanel() {
    if (!el.wrap) return;
    el.wrap.classList.remove('open');
    state = null;
    setTimeout(function () { if (el.wrap && !el.wrap.classList.contains('open')) el.wrap.style.display = 'none'; }, 260);
  }

  function currentTotal() {
    if (!state) return 0;
    var d = 0;
    Object.keys(state.sel).forEach(function (t) { var c = state.sel[t]; if (c) d += Number(c.price_delta || 0); });
    return (basePrice(state.product) + d) * state.qty;
  }
  function refreshFooter() {
    if (!state) return;
    el.qtyVal.textContent = fmtQty(state.qty);
    el.add.textContent = (state.existing ? 'Güncelle' : 'Sepete Ekle') + ' \u00B7 \u20BA' + fmtTL(currentTotal());
    var a = accent();
    el.add.style.background = a;
    [el.plus, el.minus].forEach(function (b) { b.style.color = a; b.style.borderColor = a; });
  }
  function changeQty(dir) {
    if (!state) return;
    var q = state.qty + dir * state.step;
    if (q < state.step) q = state.step;
    state.qty = Math.round(q * 100) / 100;
    refreshFooter();
  }

  function renderBody() {
    var p = state.product, a = accent();
    var h = '';
    h += '<div class="afroPName">' + escapeHtml(p.name || 'Ürün') + '</div>';
    var sub = escapeHtml((p.supplier_group || '') + '');
    h += '<div class="afroPPrice">\u20BA' + fmtTL(basePrice(p)) + '<span class="afroPUnit"> / ' + escapeHtml(p.unit || '') + '</span></div>';
    if (p.description) h += '<div class="afroPDesc">' + escapeHtml(p.description) + '</div>';
    var groups = (p.customization_options || []).filter(function (g) { return g && (g.choices || []).length; });
    // "İstemiyorum" tarzı seçenekleri her grubun EN ALTINA taşı (kararlı sıralama).
    groups.forEach(function (g) {
      g.choices = (g.choices || []).slice().sort(function (a, b) {
        return (/istemi/i.test(a.label || '') ? 1 : 0) - (/istemi/i.test(b.label || '') ? 1 : 0);
      });
    });
    groups.forEach(function (g, gi) {
      h += '<div class="afroGroup"><div class="afroGroupTitle">' + escapeHtml(g.title || ('Seçenek ' + (gi + 1))) + '</div>';
      (g.choices || []).forEach(function (c, ci) {
        var pd = Number(c.price_delta || 0);
        var extra = pd > 0 ? '<span class="afroChoiceDelta">+\u20BA' + fmtTL(pd) + '</span>' : (pd < 0 ? '<span class="afroChoiceDelta">\u2212\u20BA' + fmtTL(Math.abs(pd)) + '</span>' : '');
        h += '<label class="afroChoice" data-g="' + gi + '" data-c="' + ci + '">' +
             '<span class="afroRadio"></span>' +
             '<span class="afroChoiceLabel">' + escapeHtml(c.label || '') + '</span>' + extra + '</label>';
      });
      h += '</div>';
    });
    if (p.customization_note_enabled) {
      var lbl = p.customization_note_label || 'Not ekleyin (opsiyonel)';
      h += '<div class="afroGroup"><div class="afroGroupTitle">' + escapeHtml(lbl) + '</div>' +
           '<textarea class="afroNote" rows="2" placeholder="' + escapeHtml(lbl) + '"></textarea></div>';
    }
    el.body.innerHTML = h;

    // seçenekleri bağla
    el.body.querySelectorAll('.afroChoice').forEach(function (row) {
      row.addEventListener('click', function (ev) {
        ev.preventDefault();
        var gi = +row.getAttribute('data-g'), ci = +row.getAttribute('data-c');
        var g = groups[gi], c = g.choices[ci];
        state.sel[g.title || ('__g' + gi)] = { title: g.title || '', label: c.label || '', price_delta: Number(c.price_delta || 0) };
        // aynı gruptaki tüm satırların seçimini güncelle
        el.body.querySelectorAll('.afroChoice[data-g="' + gi + '"]').forEach(function (r2) { r2.classList.remove('sel'); });
        row.classList.add('sel');
        refreshFooter();
      });
    });
    var noteEl = el.body.querySelector('.afroNote');
    if (noteEl) { noteEl.value = state.note || ''; noteEl.addEventListener('input', function () { state.note = noteEl.value; }); }

    // varsayılan seçim: price_delta 0 / "İstemiyorum" varsa onu, yoksa ilk seçenek
    groups.forEach(function (g, gi) {
      var key = g.title || ('__g' + gi);
      var chosen = state.sel[key];
      var idx = -1;
      if (chosen) {
        (g.choices || []).forEach(function (c, ci) { if ((c.label || '') === chosen.label) idx = ci; });
      }
      if (idx < 0) {
        // Varsayılan: "İstemiyorum" (varsa); yoksa gruptaki EN ALTTAKİ seçenek.
        (g.choices || []).forEach(function (c, ci) { if (/istemi/i.test(c.label || '')) idx = ci; });
        if (idx < 0) idx = (g.choices || []).length - 1;
        if (idx < 0) idx = 0;
        var c0 = g.choices[idx];
        state.sel[key] = { title: g.title || '', label: c0.label || '', price_delta: Number(c0.price_delta || 0) };
