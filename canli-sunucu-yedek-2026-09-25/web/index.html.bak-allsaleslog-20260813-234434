        var ORANGE_ATTR = 'data-afro-orange';
        // Açık modda DOLU YEŞİL arka planlı elemanları (marka yeşili
        // rgb(20,182,126) ve yakın tonları) TURUNCU yap. Buna dahil:
        //  - küçük yeşil butonlar ("Ekle", "Pazardan Gel-Al" vb.)
        //  - üstteki yeşil "Yönetici Görünümü" bandı (köşesiz, geniş)
        //  - profildeki büyük yeşil isim/başlık kartı
        //  - alt menüdeki aktif yeşil pill (varsa)
        //  - PAZAR KARTI "Siparişe Başla" butonları (flicker düzeltmesi)
        // Beyaz yazılar turuncu üstünde okunur kaldığı için sorun olmaz.
        // Soluk yeşiller (rgb(204,230,209)) buraya GİRMEZ; onlar buzlu cam olur.
        function paintOrangeButtons() {
          var root = document.body; // modallar dahil (bkz. paintGlassLayers notu)
          if (!root) return;
          var vw = window.innerWidth, vh = window.innerHeight;
          var nodes = root.querySelectorAll('*');
          for (var i = 0; i < nodes.length; i++) {
            var el = nodes[i];
            if (el.getAttribute(ORANGE_ATTR) === '1') continue;
            var cs = getComputedStyle(el);
            var m = (cs.backgroundColor || '').match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
            if (!m) continue;
            var rr = +m[1], gg = +m[2], bb = +m[3], a = (m[4] === undefined ? 1 : +m[4]);
            if (a < 0.5) continue; // yarı saydam -> atla (dolu yeşiller hedef)
            // DOLU marka yeşili ve yakın tonları (soluk yeşiller HARİÇ)
            var isBrandGreen = (rr <= 90 && gg >= 130 && gg <= 220 && bb >= 70 && bb <= 180 && gg > rr + 50 && gg > bb + 15);
            if (!isBrandGreen) continue;
            var r = el.getBoundingClientRect();
            if (r.width < 20 || r.height < 16) continue; // çok küçük -> atla
            // Tam ekranı kaplayan bir katman OLMAMALI (güvenlik)
            if (r.width >= vw * 0.97 && r.height >= vh * 0.8) continue;
            el.setAttribute(ORANGE_ATTR, '1');
          }
          // FLICKER DÜZELTMESİ: Pazar kartı "Siparişe Başla" butonları React
          // render döngüsünde backgroundColor: theme.primary ile render ediliyor
          // ama statik CSS kuralları onları yakalamıyor. Metin bazlı tespit yapıp
          // işaretleyerek her durumda turuncu kalmasını sağlarız.
          var isMarketPage = (location.pathname === '/' || location.pathname.indexOf('/markets') > -1);
          if (isMarketPage) {
            var divs = root.querySelectorAll('div');
            for (var j = 0; j < divs.length; j++) {
              var btn = divs[j];
              if (btn.getAttribute(ORANGE_ATTR) === '1') continue;
              var txt = (btn.innerText || '').trim();
              // "Siparişe Başla" veya "Sipariş Başla" (typo toleransı)
              if (txt.indexOf('Sipari') === -1 || txt.indexOf('Ba') === -1) continue;
              if (txt.length > 25) continue; // sadece buton metni, açıklama değil
              var rb = btn.getBoundingClientRect();
              // Buton boyutu: genişlik 90-400, yükseklik 30-80
              if (rb.width < 90 || rb.width > 400 || rb.height < 30 || rb.height > 80) continue;
              // ÖNEMLİ FLICKER DÜZELTMESİ: Buton enabled iken yeşil (#14B67E),
              // fakat market verisi yeniden yüklenirken KISA süre disabled
              // duruma geçip SOLUK YEŞİL (accentSurface #CCE6D1 = rgb(204,230,209))
              // oluyor -> beyaz gibi görünüyor. Rengine göre koşul koymak yerine
              // GÖRÜNÜR DOLGUSU olan (şeffaf olmayan) buton kutusunu -yeşil, soluk
              // yeşil, beyaz, turuncu fark etmeksizin- turuncu işaretle. İç yazı
              // sarmalayıcısı (şeffaf zemin) elenir; yalnızca dolu buton kutusu geçer.
              var cBtn = getComputedStyle(btn);
              var mbtn = (cBtn.backgroundColor || '').match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
              if (!mbtn) continue;
              var ba = (mbtn[4] === undefined ? 1 : +mbtn[4]);
              // Görünür (şeffaf olmayan) dolgusu olan kutu = asıl buton.
              if (ba < 0.5) continue;
              btn.setAttribute(ORANGE_ATTR, '1');
            }
          }
        }

        function unpaintOrange() {
          var o = document.querySelectorAll('[' + ORANGE_ATTR + ']');
          for (var k = 0; k < o.length; k++) o[k].removeAttribute(ORANGE_ATTR);
