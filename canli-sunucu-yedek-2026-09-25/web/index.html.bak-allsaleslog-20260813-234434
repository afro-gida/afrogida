        // Açık modda TÜM YEŞİL yazıları/kenarlıkları/SVG'leri turuncu yap.
        function paintGreenTextsOrange() {
          var root = document.body; // modallar dahil (bkz. paintGlassLayers notu)
          if (!root) return;
          var nodes = root.querySelectorAll('*');
          for (var i = 0; i < nodes.length; i++) {
            var el = nodes[i];
            var r = el.getBoundingClientRect();
            if (r.width < 5 || r.height < 5) continue; // görünmez (offsetParent yerine boyut kontrolü)
            // NOT: alt menü (bottom nav) artık İSTİSNA DEĞİL — aktif yeşil ikon
            // ve etiketi de turuncu olsun (kullanıcı isteği). Pasif gri ikonlar
            // yeşil olmadığı için etkilenmez.
            var cs = getComputedStyle(el);
            
            // YAZI RENGİ (color)
            if (!el.getAttribute('data-afro-green-text')) {
              var col = cs.color;
              var mc = col && col.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
              if (mc) {
                var cr = +mc[1], cg = +mc[2], cb = +mc[3];
                // Yeşil: g > r+20 && g > b+20 && g >= 80 (koyu+açık yeşiller)
                if (cg > cr + 20 && cg > cb + 20 && cg >= 80) {
                  el.setAttribute('data-afro-green-text', '1');
                }
              }
            }
            
            // KENARLIK (border-color)
            if (!el.getAttribute('data-afro-green-border')) {
              var bord = cs.borderTopColor || cs.borderColor;
              var mb = bord && bord.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
              if (mb) {
                var br = +mb[1], bg = +mb[2], bb = +mb[3];
                if (bg > br + 20 && bg > bb + 20 && bg >= 80) {
                  el.setAttribute('data-afro-green-border', '1');
                }
              }
            }
            
            // SVG FILL (fill)
            if (!el.getAttribute('data-afro-green-fill') && (el.tagName === 'svg' || el.tagName === 'path' || el.tagName === 'circle')) {
              var fill = cs.fill;
              var mf = fill && fill.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
              if (mf) {
                var fr = +mf[1], fg = +mf[2], fb = +mf[3];
                if (fg > fr + 20 && fg > fb + 20 && fg >= 80) {
                  el.setAttribute('data-afro-green-fill', '1');
                }
              }
            }
          }
        }

        function unpaintGreenTexts() {
          var attrs = ['data-afro-green-text', 'data-afro-green-border', 'data-afro-green-fill'];
          for (var j = 0; j < attrs.length; j++) {
            var marked = document.querySelectorAll('[' + attrs[j] + ']');
            for (var i = 0; i < marked.length; i++) marked[i].removeAttribute(attrs[j]);
          }
        }

        // KOYU TEMA: uygulamanın kendi TURUNCU rengini (rgb(251,140,60)) kullanan
        // elemanları parlak yeşile çevir. Turuncu tolerans aralığında bg/border/color
        // olan elemanlara data-afro-d2g işareti koyar (CSS onları yeşile boyar).
        function isAppOrange(str) {
          var m = (str || '').match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
          if (!m) return false;
          var r = +m[1], g = +m[2], b = +m[3], a = (m[4] === undefined ? 1 : +m[4]);
          if (a < 0.35) return false;
          return r >= 235 && r <= 255 && g >= 118 && g <= 162 && b >= 42 && b <= 82;
        }
        function fixDarkOrangeToGreen() {
          var root = document.body; if (!root) return;
          // FLICKER DÜZELTMESİ (kupon kartı vb.): Bir eleman d2g ile yeşile
          // boyanınca getComputedStyle YEŞİL döner -> isAppOrange(false) ->
          // işaret kalkar -> tekrar turuncu -> tekrar yeşil... sonsuz TİTREME.
          // Çözüm (paintCartOutline ile aynı desen): her taramada önce TÜM d2g
          // işaretlerini KALDIR. Böylece override kalkar ve getComputedStyle
          // uygulamanın GERÇEK rengini (turuncu) döndürür; sadece gerçekten
          // turuncu olanlar yeniden işaretlenir. Tümü senkron tek geçişte olur,
          // ekranda ara turuncu kare (paint) görünmez -> titreme tamamen biter.
          // Bu yöntem, turuncu inline style ile de atomik class ile de gelse çalışır.
          unfixDarkOrange();
          var nodes = root.querySelectorAll('*');
          for (var i = 0; i < nodes.length; i++) {
            var el = nodes[i];
            var cs = getComputedStyle(el);
            var toks = [];
            if (isAppOrange(cs.backgroundColor)) toks.push('bg');
            var bw = parseFloat(cs.borderTopWidth) || 0;
            if (bw > 0 && isAppOrange(cs.borderTopColor)) toks.push('border');
            if (isAppOrange(cs.color)) toks.push('text');
            if (toks.length) {
              var v = toks.join(' ');
              if (el.getAttribute('data-afro-d2g') !== v) el.setAttribute('data-afro-d2g', v);
            } else if (el.getAttribute('data-afro-d2g')) {
              el.removeAttribute('data-afro-d2g');
            }
          }
        }
        function unfixDarkOrange() {
          var m = document.querySelectorAll('[data-afro-d2g]');
          for (var i = 0; i < m.length; i++) m[i].removeAttribute('data-afro-d2g');
        }

        // Harita seçici (map-picker.html) AYNI KÖKENLİ bir <iframe> içinde çalışır
        // ve "Bu Konumu Onayla" butonu (#confirm-btn) yeşildir (#22C55E). Ana
        // belgedeki stiller iframe'e uygulanmadığı için, aynı köken avantajıyla
        // iframe'in kendi <head>'ine küçük bir stil enjekte edip AÇIK modda
        // butonu turuncu yaparız. KOYU modda enjekte edilen stili kaldırırız.
        function paintMapIframe(makeOrange) {
          try {
            var ifr = document.querySelectorAll('iframe');
            for (var i = 0; i < ifr.length; i++) {
              var f = ifr[i];
              var src = f.getAttribute('src') || '';
              if (src.indexOf('map-picker') === -1) continue;
              var doc = null;
              try { doc = f.contentDocument; } catch (e) { doc = null; }
              if (!doc || !doc.head) continue;
              var st = doc.getElementById('afro-iframe-style');
              if (makeOrange) {
                if (!st) {
                  st = doc.createElement('style');
                  st.id = 'afro-iframe-style';
                  st.textContent = '#confirm-btn{background:rgb(251,140,60) !important;}';
                  doc.head.appendChild(st);
                }
              } else {
                if (st && st.parentNode) st.parentNode.removeChild(st);
              }
            }
          } catch (e) { /* sessizce geç */ }
        }

        // ============================================================
        // ADMIN: "Tedarikçi Yetkilendir" penceresi geliştirmesi
        // Uygulama derlenmiş (kaynak yok); bu ekranda (a) atanmış
        // tedarikçileri İSİM + TELEFON ile listeleyen ve (b) her birinde
        // "Kaldır" butonu olan bir bölümü DOM'a enjekte ederiz.
        // Backend zaten kaldırmayı destekliyor: POST /admin/staff/assign
        // {identifier, supplier_group:null} -> rol tekrar 'musteri' olur.
        // Modal, input[placeholder*="user_id"] ile ucuzca tespit edilir;
        // bu input modal kolonunun doğrudan çocuğudur, panelimizi o kolona
        // ekleriz. React re-render'da kaldırırsa tick/observer geri koyar.
        // ============================================================
        function afroAdminToken() {
          try {
            var raw = localStorage.getItem('pazar_session_token');
            if (!raw) return '';
            try { var v = JSON.parse(raw); return (typeof v === 'string') ? v : String(v || ''); }
            catch (e) { return raw; }
          } catch (e) { return ''; }
        }
        function afroApi(path, opts) {
          opts = opts || {};
          var h = { 'Content-Type': 'application/json' };
          var tk = afroAdminToken();
          if (tk) h['Authorization'] = 'Bearer ' + tk;
          return fetch('https://afrogida.com.tr/api' + path, {
            method: opts.method || 'GET',
            headers: h,
            body: opts.body ? JSON.stringify(opts.body) : undefined
          }).then(function (r) {
            return r.text().then(function (t) {
              var j = null; try { j = t ? JSON.parse(t) : null; } catch (e) { j = null; }
              if (!r.ok) { throw new Error((j && j.detail) || ('Hata ' + r.status)); }
              return j;
            });
          });
        }
        function afroSupCleanup() {
          var w = document.getElementById('afro-sup-wrap');
          if (w && w.parentNode) w.parentNode.removeChild(w);
        }
        // Para biçimlendir (₺)
        function afroFmtTL(n) {
          var v = Number(n || 0);
          return v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
        }
        function afroSupLoad() {
          var list = document.getElementById('afro-sup-list');
          if (!list) return;
          // Personel listesi + tedarikçi satış özetini birlikte çek
          Promise.all([
            afroApi('/admin/staff'),
            afroApi('/admin/supplier-sales-summary').catch(function () { return {}; })
          ]).then(function (res) {
            var rows = res[0] || [];
            var summary = res[1] || {};
            // Özeti normalize edilmiş anahtarla eşleştirmek için map kur
            var normMap = {};
            Object.keys(summary).forEach(function (k) {
              normMap[(k || '').trim().toLocaleLowerCase('tr-TR')] = summary[k];
            });
            if (!Array.isArray(rows) || !rows.length) {
              list.innerHTML = '<div style="color:#9fb3aa;font-size:13px;">Henüz atanmış tedarikçi yok.</div>';
              return;
            }
            list.innerHTML = '';
            rows.forEach(function (u) {
              var sg = u.supplier_group || '';
              var stat = normMap[sg.trim().toLocaleLowerCase('tr-TR')] || null;
              var row = document.createElement('div');
              row.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:8px;background:rgba(255,255,255,0.05);border:1px solid rgba(20,182,126,0.35);border-radius:10px;padding:8px 10px;';
              var left = document.createElement('div');
              left.style.cssText = 'display:flex;flex-direction:column;gap:2px;min-width:0;';
              var nm = document.createElement('div');
              nm.style.cssText = 'color:#e6f5ee;font-weight:700;font-size:13px;';
              nm.textContent = (u.name || 'İsimsiz') + (sg ? ' — ' + sg : '');
              var ph = document.createElement('div');
              ph.style.cssText = 'color:#8fe6c0;font-size:12px;';
              ph.textContent = u.phone || '—';
              // Toplanan tutar satırı (satılan/onaylanan ürünlerden, iade düşülmüş net)
              var tot = document.createElement('div');
              tot.style.cssText = 'color:#34d399;font-size:12px;font-weight:800;margin-top:2px;';
              if (stat) {
                tot.textContent = 'Toplanan: ' + afroFmtTL(stat.net_total) +
                  ' (' + (stat.order_count || 0) + ' satış)';
                if (Number(stat.total_refunded) > 0) {
                  tot.textContent += ' • İade: ' + afroFmtTL(stat.total_refunded);
                }
              } else {
                tot.textContent = 'Toplanan: 0,00 ₺';
              }
              left.appendChild(nm); left.appendChild(ph); left.appendChild(tot);
              // Sağ taraf: butonlar (Satış Logu + Kaldır)
              var right = document.createElement('div');
              right.style.cssText = 'flex:0 0 auto;display:flex;flex-direction:column;gap:6px;';
              var logBtn = document.createElement('div');
              logBtn.textContent = 'Satış Logu';
              logBtn.style.cssText = 'color:#fff;background:#10b981;font-weight:700;font-size:12px;padding:7px 12px;border-radius:9px;cursor:pointer;text-align:center;';
              logBtn.onclick = function () {
                if (!sg) { window.alert('Bu personele atanmış tedarikçi yok.'); return; }
                afroOpenSalesLog(sg);
              };
              var btn = document.createElement('div');
              btn.textContent = 'Kaldır';
              btn.style.cssText = 'color:#fff;background:#e5484d;font-weight:700;font-size:12px;padding:7px 12px;border-radius:9px;cursor:pointer;text-align:center;';
              btn.onclick = function () { afroSupRemove(u, btn); };
              right.appendChild(logBtn); right.appendChild(btn);
              row.appendChild(left); row.appendChild(right);
              list.appendChild(row);
            });
          }).catch(function (e) {
            list.innerHTML = '<div style="color:#e5875a;font-size:13px;">Liste alınamadı: ' + ((e && e.message) || '') + '</div>';
