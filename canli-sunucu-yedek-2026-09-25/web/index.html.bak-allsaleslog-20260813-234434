            var isCard = (r.width >= 200 && r.height >= 50);
            var isStrip = (r.width >= vw * 0.6 && r.height >= 18 && r.height < 50);
            var isCardInner = (r.width >= 100 && r.height >= 40); // kart içi alanlar
            // küçük çip/pill/saat butonu (Pazar saati, Gel-Al, Sebze etiketi,
            // Ürünleri Göster, saat butonları vb.) -> bunlar da buzlu cam olur
            var isChip = (r.width >= 40 && r.height >= 20);
            // yuvarlak ikon rozetleri (menü/profil satırlarındaki ~38px daireler):
            // neredeyse kare + büyük köşe yarıçapı (daire) -> soluk yeşil arka planlı
            // olanlar da buzlu cam olur (içindeki turuncu simge kalır).
            var minSide = Math.min(r.width, r.height);
            var isIconCircle = (r.width >= 20 && r.width <= 64 &&
                                Math.abs(r.width - r.height) <= 8 &&
                                rad >= minSide * 0.35);
            if (!isCard && !isStrip && !isCardInner && !isChip && !isIconCircle) continue;
            var bg = cs.backgroundColor;
            var m = bg && bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
            if (!m) continue;
            var rr = +m[1], gg = +m[2], bb = +m[3], a = (m[4] === undefined ? 1 : +m[4]);
            // SOLUK (açık) renkler: beyaz (r,g,b>=230) VEYA soluk yeşil/bej (her RGB>=180).
            // Yarı şeffaf da olsa yakala (a>=0.2). Tamamen görünmez (a<0.2) atla.
            var isPale = ((rr >= 230 && gg >= 230 && bb >= 230) || (rr >= 180 && gg >= 180 && bb >= 180)) && a >= 0.2;
            if (isPale) {
              el.setAttribute(GLASS_ATTR, '1');
            }
          }
        }

        // KULLANICI İSTEĞİ: bilgi kutucukları (Pazar/Gel-Al saati) ve ana/alt
        // kategori butonlarının ARKASINDAKİ geniş beyaz-buzlu bandı şeffaflaştır.
        // Sadece GENİŞ kapsayıcı bantları hedefler (bireysel butonlara dokunmaz).
        function clearNavGlass() {
          var vw = window.innerWidth;
          var g = document.querySelectorAll('[' + GLASS_ATTR + '="1"]');
          for (var i = 0; i < g.length; i++) {
            var el = g[i];
            var r = el.getBoundingClientRect();
            // Yalnızca geniş bantlar (>= ekran genişliğinin %50'si)
            if (r.width < vw * 0.5) continue;
            var t = el.innerText || '';
            // Ana kategori: en az 2 ana kategori kelimesi içeriyorsa
            var catHits = 0;
            if (t.indexOf('İNDİRİMLİ') > -1) catHits++;
            if (t.indexOf('Sebze') > -1) catHits++;
            if (t.indexOf('Meyve') > -1) catHits++;
            if (t.indexOf('Yeşillik') > -1) catHits++;
            if (t.indexOf('Zeytin') > -1) catHits++;
            // Alt kategori: en az 2 alt kategori kelimesi içeriyorsa
            var subHits = 0;
            if (t.indexOf('Domates') > -1) subHits++;
            if (t.indexOf('Kabak') > -1) subHits++;
            if (t.indexOf('Patlıcan') > -1) subHits++;
            if (t.indexOf('Biber') > -1) subHits++;
            if (t.indexOf('Diğer') > -1) subHits++;
            var hasInfo = (t.indexOf('Pazar saati') > -1 || t.indexOf('Gel-Al') > -1);
            // Üst başlık ("Ürünler"/"Fiyatlar" + market adı) bandı: sayfanın en
            // üstünde (top<70) yer alan geniş ama kısa (<=90px) buzlu cam bandı.
            // KULLANICI İSTEĞİ: koyu moddaki gibi şeffaf olsun, arkadan duvar
            // kağıdı görünsün.
            var isHeader = (r.top < 70 && r.height <= 90);
            if (catHits >= 2 || subHits >= 2 || hasInfo || isHeader) {
              el.removeAttribute(GLASS_ATTR);   // buzlu camı kaldır
              el.setAttribute(GLASS_CLEAR_ATTR, '1'); // şeffaf olarak işaretle
            }
          }
        }

        function unpaintNavGlass() {
          var c = document.querySelectorAll('[' + GLASS_CLEAR_ATTR + ']');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute(GLASS_CLEAR_ATTR);
        }

        function unpaintSectionBands() {
          var s = document.querySelectorAll('[' + SEC_BAND_ATTR + ']');
          for (var i = 0; i < s.length; i++) s[i].removeAttribute(SEC_BAND_ATTR);
        }

        // KULLANICI İSTEĞİ: ürünler sayfasındaki bölüm başlığı bantlarını
        // ("Çok al az öde", "Domates", "Biber" ... = ana kategori isimleri)
        // HER taramada yeniden işaretle. Uygulama bu bantları saydam render
        // ediyor; genel paintGlassLayers yalnızca SOLUK renkli düğümleri
        // yakaladığı için bantlar kaydırma/geri-dönüşüm sırasında tutarsız
        // görünüyordu (buzlu zemin "siliniyor"du). Burada bantları build'e özgü
        // atomik class + geometri ile kesin olarak seçip stabil frost + turuncu
        // kenarlık uyguluyoruz. unpaint-then-rescan deseni: her taramada önce
        // tüm işaretleri kaldır, sonra o anki bantları yeniden işaretle ->
        // sticky/yeniden-oluşturulan başlık düğümleri de anında yakalanır,
        // ekranda titreme olmaz (scroll + mutation + interval'da çalışır).
        function paintSectionBands() {
          // Sadece ürünler/fiyatlar sayfasında uygula
          if (window.location.pathname.indexOf('/products') === -1) { unpaintSectionBands(); return; }
          unpaintSectionBands();
          var vw = window.innerWidth;
          // r-184en5c: bu build'de bölüm başlığı bandına özgü atomik class
          // (SectionList başlık kapsayıcısı). Geometri ile doğrulanır.
          var cands = document.querySelectorAll('.r-184en5c');
          for (var i = 0; i < cands.length; i++) {
            var el = cands[i];
            var r = el.getBoundingClientRect();
            // Geniş (>=%50 ekran) + kısa (18-44px) bant; ürün kartları/uzun
            // kapsayıcılar elenir. İçinde tek başlık düğümü bulunur.
            if (r.width < vw * 0.5) continue;
            if (r.height < 18 || r.height > 44) continue;
            // Genel glass/glass-clear/dark-clear işaretleri varsa temizle ki
            // yalnızca secband kuralı geçerli olsun (çakışma önlenir).
            el.removeAttribute(GLASS_ATTR);
            el.removeAttribute(GLASS_CLEAR_ATTR);
            el.removeAttribute(DARK_CLEAR_ATTR);
            el.setAttribute(SEC_BAND_ATTR, '1');
          }
        }

        // KULLANICI İSTEĞİ: KOYU MODDA tüm "chrome" bantlarını (üst başlık,
        // bilgi kutucukları, ana/alt kategori satırları ve "Çok al az öde"/
        // "Domates" gibi bölüm başlıkları) ŞEFFAFLAŞTIR. Böylece açık moddaki
        // gibi arkadan duvar kağıdı net görünür. Solid koyu-yeşil (rgb 2,7,3)
        // GENİŞ ama KISA bantları hedefler; ürün kartları (uzun) ve tam sayfa
        // kapsayıcıları (zaten şeffaf / çok geniş) dokunulmaz.
        function clearNavDark() {
          var vw = window.innerWidth;
          var all = document.body.querySelectorAll('div');
          for (var i = 0; i < all.length; i++) {
            var el = all[i];
            var r = el.getBoundingClientRect();
            // Geniş bantlar (>= ekran genişliğinin %50'si). Mobilde bantlar
            // tam ekran genişliğinde olabildiği için ÜST genişlik sınırı YOK;
            // sayfa arka planını yükseklik filtresi eler.
            if (r.width < vw * 0.5) continue;
            // Bantlar (header/başlık/nav satırları/bilgi kutucuğu kapsayıcısı):
            // 18-220px. Bilgi kutucukları kapsayıcısı ~140px olabiliyor. Ürün
            // kartları ve tam sayfa arka planı çok daha uzun olduğu için ELENİR.
            if (r.height < 18 || r.height > 220) continue;
            var cs = getComputedStyle(el);
            var bg = cs.backgroundColor;
            if (!bg || bg.indexOf('rgb') === -1) continue;
            var m = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
            if (!m) continue;
            var rr = +m[1], gg = +m[2], bb = +m[3];
            var a = (m[4] === undefined ? 1 : +m[4]);
            if (a < 0.2) continue; // zaten görünmez -> atla
            // Solid koyu yeşil/siyah ton (rgb 2,7,3 ve yakını): tüm kanallar düşük
            var isDarkGreen = (rr <= 12 && gg <= 18 && bb <= 12);
            if (!isDarkGreen) continue;
            el.setAttribute(DARK_CLEAR_ATTR, '1');
          }
        }

        function unpaintNavDark() {
          var c = document.querySelectorAll('[' + DARK_CLEAR_ATTR + ']');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute(DARK_CLEAR_ATTR);
        }

        // KULLANICI İSTEĞİ: SEPET SAYFASINDA (/cart) turuncu dolu butonları ve
        // sarımtırak kutuları ŞEFFAF-BUZLU OUTLINE style'a çevir. Buna dahil:
        // "Pazardan Gel-Al", "Tezgahta Nakit/Pos" butonları, "Teslim Alma Saati"
        // kutusu, "Ara Toplam" özet kutusu. Sadece AÇIK modda + sepet sayfasında.
        function paintCartOutline() {
          // Sadece sepet sayfasında uygula
          if (window.location.pathname.indexOf('/cart') === -1) return;
          // ÖNEMLİ (buton aktif/pasif takılması düzeltmesi): her taramada önce
          // mevcut işaretleri KALDIR. Böylece override kalkar, getComputedStyle
          // uygulamanın GERÇEK rengini döndürür; sadece ŞU AN turuncu (aktif) olan
          // buton yeniden işaretlenir. Pasif hale gelen buton (surface rengi)
          // artık işaretlenmez -> rengi "sönmüyor" bug'ı biter. Tümü senkron
          // tek geçişte olduğu için ekranda titreme görünmez.
          unpaintCartOutline();
          var vw = window.innerWidth;
          var all = document.body.querySelectorAll('div');
          for (var i = 0; i < all.length; i++) {
            var el = all[i];
            if (el.getAttribute(CART_OUTLINE_ATTR) === '1') continue; // zaten işaretli
            var r = el.getBoundingClientRect();
            // Buton/kutu boyutunda: min 150px genişlik, 35-150px yükseklik.
            // Dev sayfa kapsayıcılarını (>150px yükseklik) atla.
            if (r.width < 150 || r.height < 35 || r.height > 150) continue;
            var cs = getComputedStyle(el);
            var bg = cs.backgroundColor;
            if (!bg || bg.indexOf('rgb') === -1) continue;
            var m = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
            if (!m) continue;
            var rr = +m[1], gg = +m[2], bb = +m[3];
            var a = (m[4] === undefined ? 1 : +m[4]);
            if (a < 0.6) continue; // zaten yarı şeffaf olanları atla
            // TURUNCU DOLU (rgb 251,140,60 ± tolerans) VEYA SARIMTRAK DOLU
            // (rgb 255,235,210 civarı - özet kutusu) butonları/kutuları yakala
            var isOrange = (rr > 240 && gg > 120 && gg < 160 && bb > 40 && bb < 80);
            var isBeige = (rr > 240 && gg > 220 && bb > 190);
            if (isOrange || isBeige) {
              // Önce turuncu dolu stilini kaldır, sonra outline stilini uygula
              el.removeAttribute('data-afro-orange');
              el.setAttribute(CART_OUTLINE_ATTR, '1');
            }
          }
        }

        function unpaintCartOutline() {
          var c = document.querySelectorAll('[' + CART_OUTLINE_ATTR + ']');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute(CART_OUTLINE_ATTR);
        }

        // KULLANICI İSTEĞİ: Sepette arka planı ŞEFFAF olup duvar kağıdı direkt
        // görünen, bu yüzden yazısı okunmayan bloklara BUZLU-CAM panel ekle.
        // Hedef: "Sipariş Tamamlama" bloğu (başlık + açıklama + sözleşme onay
        // satırını kapsayan sarmalayıcı). Sadece AÇIK mod + sepet sayfası.
        function paintCartFrost() {
          if (window.location.pathname.indexOf('/cart') === -1) return;
          var vw = window.innerWidth;
          var headerDone = false;
          var all = document.body.querySelectorAll('div');
          for (var i = 0; i < all.length; i++) {
            var el = all[i];
            if (el.getAttribute(CART_FROST_ATTR) === '1' || el.getAttribute(CART_FILL_ATTR) === '1') continue;
            var t = (el.innerText || '').replace(/\s+/g, ' ').trim();
            if (!t) continue;
            var r = el.getBoundingClientRect();
            // Üst başlık alt satırı ("X çeşit ürün • ₺..") soluk gri-yeşil ->
            // duvar kağıdı üstünde okunması için KOYU renge çevir (genişlik kapısından önce).
            if (/^\d+ çeşit ürün/.test(t) && r.top < 210 && r.height <= 40) {
              el.setAttribute('data-afro-cart-darktext', '1');
            }
            if (r.width < 150) continue;
            // Sipariş oluştur butonu -> YEŞİL yap (yazısı beyaz/okunur olsun).
            if (t.indexOf('Siparişi Oluştur') > -1 && r.width > 300 && r.height >= 40 && r.height <= 90) {
              el.setAttribute('data-afro-order-btn', '1');
              continue;
            }
            var role = ''; // 'panel' = tam buzlu panel, 'fill' = kartı buzlu-cam doldur
            // App'in zayıf yarı-şeffaf beyaz kartı mı? (rgba(255,255,255,~0.45))
            var cs = getComputedStyle(el);
            var m = cs.backgroundColor.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
            var isWhiteCard = false;
            if (m) {
              var rr = +m[1], gg = +m[2], bb = +m[3], aa = (m[4] === undefined ? 1 : +m[4]);
              isWhiteCard = (rr >= 250 && gg >= 250 && bb >= 250 && aa >= 0.3 && aa <= 0.6);
            }
            // A) Sözleşme bloğu (Sipariş Tamamlama başlık+açıklama+onay) -> tam panel.
            //    "Sipariş Oluştur" butonunu da kapsayan büyük blokları atla.
            if (t.indexOf('Sipariş Tamamlama') === 0 && t.indexOf('okudum ve kabul') > -1) {
              if (r.height >= 50 && r.height <= 200) role = 'panel';
            }
            // (Üst "Sepetim" başlığı KULLANICI İSTEĞİYLE artık frost YAPILMIYOR;
            //  duvar kağıdı görünsün diye şeffaf bırakılıyor.)
            // C) SADECE istenen içerik kartlarını buzlu-cam doldur (buton/alt menü/
            //    kupon gibi kontrollere DOKUNMA). Kart = zayıf beyaz arka planlı olan.
            else if (isWhiteCard && r.height >= 30 && r.height <= 320) {
              if (t.indexOf('Ara Toplam') > -1) role = 'fill';                        // özet kutusu
              else if (t.indexOf('Eve servis verilen mahalleler') > -1) role = 'fill'; // mahalleler kutusu
              else if (t.indexOf('Ürünleri Göster') > -1 && t.indexOf('çeşit ürün') > -1) role = 'fill'; // üst özet kartı
              else if (r.height <= 120 && /(Mah\.|Mah |Sok|Sk\.|Cad|Cd\.|No:|Kat:|Daire)/i.test(t)) role = 'fill'; // adres kutusu
            }
            if (!role) continue;
            // İç içe eşleşmeleri önle: bir atası zaten panel/fill olduysa atla
            // (çift panel / çift blur olmasın, sadece en dıştaki işaretlensin).
            var anc = el.parentElement, skip = false;
            while (anc) {
              if (anc.getAttribute && (anc.getAttribute(CART_FROST_ATTR) === '1' ||
                  anc.getAttribute(CART_FILL_ATTR) === '1')) { skip = true; break; }
              anc = anc.parentElement;
            }
            if (skip) continue;
            el.setAttribute(role === 'panel' ? CART_FROST_ATTR : CART_FILL_ATTR, '1');
          }
        }

        function unpaintCartFrost() {
          var c = document.querySelectorAll('[' + CART_FROST_ATTR + '], [' + CART_FILL_ATTR + '], [data-afro-order-btn], [data-afro-cart-darktext]');
          for (var i = 0; i < c.length; i++) {
            c[i].removeAttribute(CART_FROST_ATTR);
            c[i].removeAttribute(CART_FILL_ATTR);
            c[i].removeAttribute('data-afro-order-btn');
            c[i].removeAttribute('data-afro-cart-darktext');
          }
        }

        // KULLANICI İSTEĞİ: Alttaki menü çubuğunu (Pazarlar/Fırsatlar/Sepet/
        // Kuponlar/Profil) YÜZEN bir "ada/pill" şekline çevir (yuvarlak köşe,
        // kenarlardan boşluk, gölge, buzlu cam). Tüm sayfalarda çalışır.
        function paintNavPill() {
          var all = document.body.querySelectorAll('div');
          var pill = null;
          for (var i = 0; i < all.length; i++) {
            var el = all[i];
            if (el.getAttribute('data-afro-navpill') === '1') { pill = el; continue; }
            var t = (el.innerText || '').replace(/\s+/g, ' ').trim();
            if (t.length > 90) continue;
            if (t.indexOf('Pazarlar') === -1 || t.indexOf('Sepet') === -1 ||
                t.indexOf('Profil') === -1) continue;
            var r = el.getBoundingClientRect();
            // Menü çubuğunun kendisi: kısa (yükseklik ~50-90), geniş.
            if (r.height < 45 || r.height > 95 || r.width < 300) continue;
            var cs = getComputedStyle(el);
            var m = cs.backgroundColor.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
            var aa = m ? (m[4] === undefined ? 1 : +m[4]) : 0;
            var hasBorder = parseFloat(cs.borderTopWidth) > 0 || parseFloat(cs.borderBottomWidth) > 0;
            if (aa < 0.1 && !hasBorder) continue; // şeffaf iç satırı değil, asıl bar
            el.setAttribute('data-afro-navpill', '1');
            pill = el;
          }
          // Pill'i YÜZEN yap (absolute) + kardeş kaydırma kabına alt boşluk ekle ki
          // içerik/butonlar pill'in ALTINDAN geçebilsin (kesik bant kalksın).
          if (pill) {
            var col = pill.parentElement;
            if (col && !col.querySelector('[data-afro-navpad="1"]')) {
              for (var c = 0; c < col.children.length; c++) {
                var kid = col.children[c];
                if (kid === pill) continue;
                var found = null;
                var kcs = getComputedStyle(kid);
                if (kcs.overflowY === 'auto' || kcs.overflowY === 'scroll') found = kid;
                if (!found) {
                  var inner = kid.querySelectorAll('div');
                  for (var s = 0; s < inner.length; s++) {
                    var e2 = inner[s]; var e2cs = getComputedStyle(e2);
                    if ((e2cs.overflowY === 'auto' || e2cs.overflowY === 'scroll') &&
                        e2.scrollHeight > e2.clientHeight + 20) { found = e2; break; }
                  }
                }
                if (found) found.setAttribute('data-afro-navpad', '1');
              }
            }
          }
        }
        function unpaintNavPill() {
          var c = document.querySelectorAll('[data-afro-navpill], [data-afro-navpad]');
          for (var i = 0; i < c.length; i++) {
            c[i].removeAttribute('data-afro-navpill');
            c[i].removeAttribute('data-afro-navpad');
          }
        }

        // Alt menü (tab bar) ikonları/etiketleri: PASİF sekmeler eski gri-yeşil
        // rgb(120,144,130) renkte kalıyordu. Bunları temaya uygun MAT TURUNCU yap.
        // AKTİF sekme uygulamanın parlak turuncusunda (251,140,60) kalsın ki
        // hangi sekmede olduğumuz belli olsun. Her tick'te önce temizleyip yeniden
        // boyar; böylece sekme değişince aktif/pasif doğru güncellenir.
        function paintNavIcons() {
          unpaintNavIcons();
          var all = document.body.querySelectorAll('div');
          var pill = null;
          for (var i = 0; i < all.length; i++) {
            var t = (all[i].innerText || '').replace(/\s+/g, ' ').trim();
            if (t.indexOf('Pazarlar') > -1 && t.indexOf('Sepet') > -1 &&
                t.indexOf('Profil') > -1) {
              var r = all[i].getBoundingClientRect();
              if (r.height > 40 && r.height < 110 && r.width > 300) { pill = all[i]; break; }
            }
          }
          if (!pill) return;
          var els = pill.querySelectorAll('*');
          for (var j = 0; j < els.length; j++) {
            var e = els[j];
            if (e.children.length > 0) continue;      // sadece yaprak (glyph/etiket)
            if (!(e.textContent || '').trim()) continue;
            var m = getComputedStyle(e).color.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
            if (!m) continue;
            var R = +m[1], G = +m[2], B = +m[3];
            // AKTİF sekme = parlak turuncu -> dokunma; gerisi (siyah/gri-yeşil vs.) mat turuncu
            var isActive = (R >= 235 && G >= 110 && G <= 170 && B <= 95);
            if (isActive) continue;
            e.style.setProperty('color', 'rgb(230, 150, 95)', 'important');
            e.setAttribute('data-afro-navicon', '1');
          }
        }
        function unpaintNavIcons() {
          var c = document.querySelectorAll('[data-afro-navicon]');
          for (var i = 0; i < c.length; i++) {
            c[i].style.removeProperty('color');
            c[i].removeAttribute('data-afro-navicon');
          }
        }

        // Ürün sayfasında sepete ürün eklenince alttan çıkan turuncu
        // "Siparişi Tamamla" çubuğu, yüzen pill ile çakışır. Onu bulup işaretle;
        // CSS pill'in ÜSTÜNE kaydırır.
        function paintCartBar() {
          var nodes = document.body.querySelectorAll('div');
          for (var i = 0; i < nodes.length; i++) {
            var el = nodes[i];
            if (el.getAttribute('data-afro-cartbar') === '1') continue;
            var t = (el.innerText || '').replace(/\s+/g, ' ').trim();
            if (t.indexOf('Siparişi Tamamla') === -1) continue;
            if (t.length > 55) continue; // sadece çubuk etiketi + tutar
            var node = el, bar = null;
            for (var k = 0; k < 6 && node; k++) {
              var cs = getComputedStyle(node);
              var r = node.getBoundingClientRect();
              if ((cs.position === 'absolute' || cs.position === 'fixed') &&
                  r.width > window.innerWidth * 0.5 && r.height < 130) {
                bar = node; break;
              }
              node = node.parentElement;
            }
            if (bar) bar.setAttribute('data-afro-cartbar', '1');
          }
        }
        function unpaintCartBar() {
          var c = document.querySelectorAll('[data-afro-cartbar]');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute('data-afro-cartbar');
        }

        // Üstteki bilgi kutucuklarını (Pazar saati / Gel-Al saati / minimum vb.)
        // bul ve işaretle; CSS onları şeffaf buzlu cam yapar.
        var INFO_CHIP_KEYS = ['Pazar saati', 'Gel-Al saati', 'Gel-Al minimum',
          'Eve Servis Saati', 'Eve Servis minimum'];
        function paintInfoChips() {
          var divs = document.body.querySelectorAll('div');
          for (var i = 0; i < divs.length; i++) {
            var e = divs[i];
            var t = (e.innerText || '').replace(/\s+/g, ' ').trim();
            var hit = false;
            for (var q = 0; q < INFO_CHIP_KEYS.length; q++) {
              if (t.indexOf(INFO_CHIP_KEYS[q]) === 0 && t.length < 40) { hit = true; break; }
            }
            if (!hit) continue;
            // metin düğümünden yukarı çıkıp arka planı olan "pill"i bul
            var node = e, chip = null;
            for (var k = 0; k < 5 && node; k++) {
              var cs = getComputedStyle(node);
              var r = node.getBoundingClientRect();
              var m = cs.backgroundColor.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
              var aa = m ? (m[4] === undefined ? 1 : +m[4]) : 0;
              if (aa > 0.05 && r.height > 20 && r.height < 60 &&
                  parseFloat(cs.borderTopLeftRadius) > 8) { chip = node; break; }
              node = node.parentElement;
            }
            if (chip) chip.setAttribute('data-afro-infochip', '1');
          }
        }
        function unpaintInfoChips() {
          var c = document.querySelectorAll('[data-afro-infochip]');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute('data-afro-infochip');
        }

        // "Çok al az öde" başlığına tıklanınca ürün listesini EN ÜSTE kaydır.
        // (Diğer kategori çipleri kendi bölümüne kaydırıyor; bu başlık en üste
        // dönmeyi sağlar.) Enjekte edilmiş, geri alınabilir bir davranış.
        function findMainScroll() {
          var sc = null;
          var all = document.querySelectorAll('*');
          for (var i = 0; i < all.length; i++) {
            var e = all[i]; var cs = getComputedStyle(e);
            if ((cs.overflowY === 'auto' || cs.overflowY === 'scroll') &&
                e.scrollHeight > e.clientHeight + 40) {
              if (!sc || e.clientHeight > sc.clientHeight) sc = e;
            }
          }
          return sc;
        }
        function wireScrollTop() {
          var divs = document.body.querySelectorAll('div');
          for (var i = 0; i < divs.length; i++) {
            var e = divs[i];
            if (e.getAttribute('data-afro-scrolltop') === '1') continue;
            var t = (e.innerText || '').replace(/\s+/g, ' ').trim();
            if (t !== 'Çok al az öde') continue;
            var r = e.getBoundingClientRect();
            if (r.height < 12 || r.height > 40 || r.width > 220) continue;
            e.setAttribute('data-afro-scrolltop', '1');
            e.addEventListener('click', function (ev) {
              var sc = findMainScroll();
              if (sc) { try { sc.scrollTo({ top: 0, behavior: 'smooth' }); } catch (x) { sc.scrollTop = 0; } }
            }, true);
          }
        }
        function unwireScrollTop() {
          var c = document.querySelectorAll('[data-afro-scrolltop]');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute('data-afro-scrolltop');
        }

        // Profil/Ayarlar sayfasındaki opak kartları bul (menü satırları, bildirim,
        // tema, hesap kartları) ve işaretle; CSS onları şeffaf buzlu cam yapar.
        // Koyu temada kartlar opak rgb(8,18,12); açık temada zaten yarı-şeffaf beyaz.
        function paintGlassCards() {
          // Profil/Ayarlar sayfalarındaki kartlar
          var isProfileOrSettings = (location.pathname.indexOf('profile') > -1 ||
                                      location.pathname.indexOf('settings') > -1);
          // Teslimat adresi yönetim sayfası
          var isAddressManager = (location.pathname.indexOf('address-manager') > -1 ||
                                   location.pathname.indexOf('address') > -1);
          
          if (!isProfileOrSettings && !isAddressManager) return;
          
          var divs = document.body.querySelectorAll('div');
          for (var i = 0; i < divs.length; i++) {
            var e = divs[i];
            if (e.getAttribute('data-afro-glasscard') === '1') continue;
            var cs = getComputedStyle(e);
            var br = parseFloat(cs.borderTopLeftRadius) || 0;
            if (br < 12) continue; // yuvarlak köşeli kartlar (12px+ radius)
            var r = e.getBoundingClientRect();
            if (r.width < 280 || r.width > 660) continue; // içerik kolonu genişliği
            if (r.height < 40) continue;
            var m = cs.backgroundColor.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
            if (!m) continue;
            var R = +m[1], G = +m[2], B = +m[3];
            var a = m[4] === undefined ? 1 : +m[4];
            // Koyu tema kartı: neredeyse opak + koyu renk (turuncu başlık/yeşil
            // seçili satır ELENMELİ; onlar koyu değil).
            var isDarkCard = (a > 0.85 && R < 45 && G < 55 && B < 45);
            // Açık tema kartı: yarı-şeffaf VEYA tam opak beyaz (a >= 0.2).
            // Teslimat adresi kartları tam opak (a=1) olabiliyor.
            var isLightCard = (a >= 0.2 && R > 220 && G > 220 && B > 220);
            if (!isDarkCard && !isLightCard) continue;
            e.setAttribute('data-afro-glasscard', '1');
          }
        }
        function unpaintGlassCards() {
          var c = document.querySelectorAll('[data-afro-glasscard]');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute('data-afro-glasscard');
        }

        // REQ1: Ürünler/pazar sayfasının üst BAŞLIK satırına (market adı) tam
        // genişlikte şeffaf buzlu panel işaretle.
        function paintHeaderPanel() {
          var TITLES = ['Ürünler', 'Olduğumuz Pazarlar'];
          var divs = document.body.querySelectorAll('div');
          for (var i = 0; i < divs.length; i++) {
            var e = divs[i];
            var t = (e.innerText || '').replace(/\s+/g, ' ').trim();
            if (TITLES.indexOf(t) === -1) continue;
            var n = e;
            for (var k = 0; k < 5 && n; k++) {
              var r = n.getBoundingClientRect();
              if (r.width > window.innerWidth * 0.6 && r.height >= 30 && r.height <= 92) {
                if (n.getAttribute('data-afro-headerpanel') !== '1')
                  n.setAttribute('data-afro-headerpanel', '1');
                break;
              }
              n = n.parentElement;
            }
          }
        }
        function unpaintHeaderPanel() {
          var c = document.querySelectorAll('[data-afro-headerpanel]');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute('data-afro-headerpanel');
          var k = document.querySelectorAll('[data-afro-headerclip]');
          for (var j = 0; j < k.length; j++) k[j].removeAttribute('data-afro-headerclip');
        }
        // Kullanıcı isteği: "Ürünler" başlığına DEĞİL, BİLGİ KUTUCUKLARININ
        // olduğu satıra tam genişlikte buzlu panel. Bilgi çipi (glyph + "saati"/
        // "minimum"/"Servis"/"Teslimat") bul, yukarı çıkıp yatay kaydırma
        // (overflowX auto/scroll) satırını işaretle -> CSS onu buzlu panel yapar.
        function paintInfoRowPanel() {
          var all = document.body.querySelectorAll('div');
          var chip = null;
          for (var i = 0; i < all.length; i++) {
            var t = (all[i].innerText || '').replace(/\s+/g, ' ').trim();
            if (!t || t.length > 40) continue;
            if (t.charCodeAt(0) < 0xE000) continue; // ikon glyph ile başlamalı
            if (t.indexOf('saati') === -1 && t.indexOf('minimum') === -1 &&
                t.indexOf('Servis') === -1 && t.indexOf('Teslimat') === -1) continue;
            if (all[i].offsetParent === null) continue;
            var r = all[i].getBoundingClientRect();
            if (r.height < 18 || r.height > 42 || r.width < 80 || r.width > 300) continue;
            chip = all[i];
            break;
          }
          if (!chip) return;
          var n = chip, row = null;
          for (var k = 0; k < 6 && n; k++) {
            var cs = getComputedStyle(n);
            if (cs.overflowX === 'auto' || cs.overflowX === 'scroll') { row = n; break; }
            n = n.parentElement;
          }
          if (!row) return;
          if (row.getAttribute('data-afro-headerpanel') !== '1')
            row.setAttribute('data-afro-headerpanel', '1');
          // Panelin bir üstündeki NATIVE kapsayıcı overflow:hidden ile panelin
          // yuvarlak alt köşelerini kırpıyor. Onu da işaretle -> CSS
          // overflow:visible yapar ("altı kesik" düzelir).
          var clip = row.parentElement;
          if (clip && clip.getAttribute('data-afro-headerclip') !== '1')
            clip.setAttribute('data-afro-headerclip', '1');
        }

        // REQ2: Profil sayfasındaki en üstteki DOLU (yeşil ya da turuncuya
        // dönüşmüş) isim/yönetici kartını bul; CSS onu şeffaf buzlu cam yapar.
        function paintMgrCard() {
          if (location.pathname.indexOf('profile') === -1) return;
          var divs = document.body.querySelectorAll('div');
          var best = null, bestTop = 1e9;
          for (var i = 0; i < divs.length; i++) {
            var e = divs[i];
            if (e.getAttribute('data-afro-mgrcard') === '1') return; // zaten işaretli
            var cs = getComputedStyle(e);
            var br = parseFloat(cs.borderTopLeftRadius) || 0;
            if (br < 16) continue;
            var r = e.getBoundingClientRect();
            if (r.width < 260 || r.width > 680) continue;
            if (r.height < 90 || r.height > 230) continue;
            var m = cs.backgroundColor.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
            if (!m) continue;
            var R = +m[1], G = +m[2], B = +m[3], a = (m[4] === undefined ? 1 : +m[4]);
            if (a < 0.7) continue;
            var isGreen = (R <= 90 && G >= 120 && B >= 60 && B <= 190 && G > R + 40);
            var isOrange = (R > 225 && G >= 110 && G <= 170 && B < 100);
            if (!isGreen && !isOrange) continue;
            if (r.top < bestTop) { bestTop = r.top; best = e; }
          }
          if (best) best.setAttribute('data-afro-mgrcard', '1');
        }
        function unpaintMgrCard() {
          var c = document.querySelectorAll('[data-afro-mgrcard]');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute('data-afro-mgrcard');
        }

        // REQ3: Sepet "Ara Toplam ... Toplam" özet kutusunu bul; CSS onu belirgin
        // şeffaf buzlu panel yapar (her iki tema).
        function paintCartSummary() {
          var divs = document.body.querySelectorAll('div');
          for (var i = 0; i < divs.length; i++) {
            var e = divs[i];
            if (e.getAttribute('data-afro-cartsum') === '1') continue;
            var t = (e.innerText || '').replace(/\s+/g, ' ').trim();
            if (t.indexOf('Ara Toplam') === -1 || t.indexOf('Toplam') === -1) continue;
            var cs = getComputedStyle(e);
            var br = parseFloat(cs.borderTopLeftRadius) || 0;
            if (br < 12) continue;
            var r = e.getBoundingClientRect();
            if (r.height < 60 || r.height > 460) continue;
            if (r.width < 260) continue;
            e.setAttribute('data-afro-cartsum', '1');
          }
        }
        function unpaintCartSummary() {
          var c = document.querySelectorAll('[data-afro-cartsum]');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute('data-afro-cartsum');
        }

        // REQ5: ALT KATEGORİ çiplerini (ikinci kategori satırı) YEŞİL yap. İki
        // kategori satırından ALTTAKİ (main satırın hemen altındaki) satır alt
        // kategoridir; onu işaretle. Ürün rozetleri (aşağıda) hariç tutulur.
        function isOrangeStr(str) {
          var m = str.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
          if (!m) return false;
          var R = +m[1], G = +m[2], B = +m[3];
          return R > 225 && G >= 110 && G <= 170 && B < 100;
        }
        function paintSubCatGreen() {
          // Renkten BAĞIMSIZ satır-gruplama: kategori alanındaki tüm ÇİP
          // şeklindeki (yuvarlak, düz metin) elemanları topla. En üstteki grup
          // = ANA kategori satırı; hemen altındaki grup = ALT kategori satırı.
          // Alt satırdaki TURUNCU çipleri yeşile boya. Koyu temada ana satırın
          // aktif çipi yeşil olduğu için renge göre ayırmak güvenilmez; konum
          // (satır sırası) kullanılır.
          // ÖNCE eski etiketleri temizle: kaydırmada React düğümleri geri
          // dönüştürünce eski "subcat" etiketi yanlış eleman üstünde takılı
          // kalıp KISA YEŞİL PARLAMAYA yol açıyordu. Her boyamada sıfırla.
          unpaintSubCatGreen();
          var divs = document.body.querySelectorAll('div');
          var cands = [];
          for (var i = 0; i < divs.length; i++) {
            var e = divs[i];
            if (e.offsetParent === null) continue; // gizli/display:none ağaçlar
            var cs = getComputedStyle(e);
            if (cs.visibility === 'hidden' || cs.opacity === '0') continue;
            var br = parseFloat(cs.borderTopLeftRadius) || 0;
            if (br < 40) continue; // yuvarlak pill değilse atla
            var r = e.getBoundingClientRect();
            if (r.top < 60 || r.top > 320) continue;
            if (r.height < 16 || r.height > 40) continue;
            if (r.width < 34 || r.width > 220) continue;
            // Metni al: bilgi kutucukları / gün rozetleri / "İNDİRİMLİ" bir
            // İKON glyph ile BAŞLAR (char code >= 0xE000). Gerçek kategori
            // çipleri düz metindir (Domates, Biber...). Bunları ele.
            var txt = (e.textContent || '').replace(/^\s+/, '');
            if (txt) {
              var c0 = txt.charCodeAt(0);
              if (c0 >= 0xE000) continue; // ikon glyph ile başlıyor -> bilgi/rozet
            }
            if (txt.indexOf('Göster') !== -1) continue; // "Ürünleri Göster" butonu
            var bgOrange = isOrangeStr(cs.backgroundColor);
            var bordOrange = isOrangeStr(cs.borderTopColor);
            cands.push({ el: e, top: Math.round(r.top), orange: (bgOrange || bordOrange), active: bgOrange });
          }
          if (cands.length < 2) return;
          // Satırlara göre grupla (15px tolerans), üstten alta sırala.
          cands.sort(function (a, b) { return a.top - b.top; });
          var groups = [];
          for (var g = 0; g < cands.length; g++) {
            var placed = false;
            for (var h = 0; h < groups.length; h++) {
              if (Math.abs(groups[h].top - cands[g].top) <= 15) { groups[h].items.push(cands[g]); placed = true; break; }
            }
            if (!placed) groups.push({ top: cands[g].top, items: [cands[g]] });
          }
          groups.sort(function (a, b) { return a.top - b.top; });
          if (groups.length < 2) return; // alt kategori satırı yok
          // İkinci grup = ALT kategori satırı. Turuncu olanları yeşile boya.
          var sub = groups[1].items;
          for (var s = 0; s < sub.length; s++) {
            if (!sub[s].orange) continue;
            sub[s].el.setAttribute('data-afro-subcat', sub[s].active ? 'active' : '1');
          }
        }
        function unpaintSubCatGreen() {
          var c = document.querySelectorAll('[data-afro-subcat]');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute('data-afro-subcat');
        }

        // KULLANICI İSTEĞİ: alt kategori çip ŞERİDİ, native dikey padding
        // (üst 0 / alt 8px) yüzünden çip ŞERİDİN ÜSTÜNE YAPIŞIK duruyordu.
        // Çiplerin buzlu-cam şerit atasını işaretle -> CSS dengeli 5/5 padding
        // ile çipi dikeyde ortalar. Sadece ANA + ALT olmak üzere >=2 çip satırı
        // varken (yani gerçek bir alt kategori şeridi mevcutken) uygulanır;
        // aksi halde tek satırlı ana kategori şeridine dokunmayız.
        function padSubCatStrip() {
          unpadSubCatStrip();
          var divs = document.body.querySelectorAll('div');
          var cands = [];
          for (var i = 0; i < divs.length; i++) {
            var e = divs[i];
            if (e.offsetParent === null) continue;
            var cs = getComputedStyle(e);
            if ((parseFloat(cs.borderTopLeftRadius) || 0) < 40) continue; // pill değil
            var r = e.getBoundingClientRect();
            if (r.top < 120 || r.top > 320) continue; // kategori bölgesi
            if (r.height < 16 || r.height > 40) continue;
            if (r.width < 34 || r.width > 240) continue;
            var txt = (e.textContent || '').replace(/^\s+/, '');
            if (txt && txt.charCodeAt(0) >= 0xE000) continue; // ikon glyph -> bilgi/rozet
            if (txt.indexOf('Göster') !== -1) continue;
            cands.push({ el: e, top: Math.round(r.top) });
          }
          if (cands.length < 2) return;
          // Satırlara ayır (15px tolerans); >=2 satır yoksa alt kategori yok.
          var rows = [];
          for (var g = 0; g < cands.length; g++) {
            var placed = false;
            for (var h = 0; h < rows.length; h++) {
              if (Math.abs(rows[h].top - cands[g].top) <= 15) { rows[h].items.push(cands[g]); placed = true; break; }
            }
            if (!placed) rows.push({ top: cands[g].top, items: [cands[g]] });
          }
          if (rows.length < 2) return;
          rows.sort(function (a, b) { return a.top - b.top; });
          var sub = rows[rows.length - 1].items; // en alttaki satır = alt kategori
          for (var p = 0; p < sub.length; p++) {
            var n = sub[p].el;
            for (var k = 0; k < 6 && n; k++) {
              var ncs = getComputedStyle(n);
              var m = ncs.backgroundColor.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
              var a = m ? (m[4] === undefined ? 1 : +m[4]) : 0;
              var nr = n.getBoundingClientRect();
              // Dolu-genişlikteki buzlu-cam şerit (yarı saydam zemin)
              if (a > 0.05 && nr.width > 240) {
                if (n.getAttribute('data-afro-substrip') !== '1')
                  n.setAttribute('data-afro-substrip', '1');
                break;
              }
              n = n.parentElement;
            }
          }
        }
        function unpadSubCatStrip() {
          var c = document.querySelectorAll('[data-afro-substrip]');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute('data-afro-substrip');
        }

        // KULLANICI İSTEĞİ: kategori çiplerinin (ana + alt) SEÇİLİ OLMAYAN
        // beyaz/soluk/buzlu dolgusunu KALDIR; içinden duvar kağıdı görünsün.
        // Sadece dolgu şeffaflaşır (turuncu/yeşil KENAR ve YAZI korunur).
        // Seçili (dolu turuncu ya da dolu yeşil) çiplere DOKUNMAZ.
        function clearCatChipFill() {
          unpaintCatChipFill(); // flicker önleme: eski işaretleri temizle
          var CATS = { 'İNDİRİMLİ': 1, 'Sebze': 1, 'Meyve': 1, 'Yeşillik': 1,
                       'Zeytin Ürünleri': 1, 'Domates': 1, 'Kabak': 1,
                       'Patlıcan': 1, 'Biber': 1, 'Diğer': 1 };
          var divs = document.body.querySelectorAll('div');
          for (var i = 0; i < divs.length; i++) {
            var e = divs[i];
            var raw = (e.innerText || '').replace(/\s+/g, ' ').trim();
            if (!raw || raw.length > 22) continue;
            // ikon glyph'lerini at, saf kategori metnini bırak
            var txt = raw.replace(/[\uE000-\uF8FF]/g, '').trim();
            if (!CATS.hasOwnProperty(txt)) continue;
            var r = e.getBoundingClientRect();
            if (r.height < 20 || r.height > 46 || r.width < 40 || r.width > 240) continue;
            // Seçili (dolu turuncu ya da dolu yeşil) çip mi? -> dokunma
            var cs = getComputedStyle(e);
            var m = cs.backgroundColor.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
            if (m) {
              var R = +m[1], G = +m[2], B = +m[3], a = (m[4] === undefined ? 1 : +m[4]);
              var isOrangeFill = (a > 0.55 && R > 220 && G >= 100 && G <= 185 && B < 120);
              var isGreenFill  = (a > 0.55 && R < 70 && G > 140 && B >= 90 && B <= 170);
              if (isOrangeFill || isGreenFill) continue; // seçili çip, dolu kalsın
            }
            // Pasif çip: buzlu-cam işaretini kaldır + dolguyu şeffaflaştır
            if (e.getAttribute(GLASS_ATTR) === '1') e.removeAttribute(GLASS_ATTR);
            if (e.getAttribute('data-afro-catchip-clear') !== '1')
              e.setAttribute('data-afro-catchip-clear', '1');
          }
        }
        function unpaintCatChipFill() {
          var c = document.querySelectorAll('[data-afro-catchip-clear]');
          for (var i = 0; i < c.length; i++) c[i].removeAttribute('data-afro-catchip-clear');
        }

        function unpaint() {
          var marked = document.querySelectorAll('[' + WP_ATTR + ']');
          for (var i = 0; i < marked.length; i++) marked[i].removeAttribute(WP_ATTR);
          var g = document.querySelectorAll('[' + GLASS_ATTR + ']');
          for (var j = 0; j < g.length; j++) g[j].removeAttribute(GLASS_ATTR);
          var o = document.querySelectorAll('[data-afro-orange]');
          for (var k = 0; k < o.length; k++) o[k].removeAttribute('data-afro-orange');
          unpaintGreenTexts();
          unpaintNavGlass();
          unpaintNavDark();
          unpaintCartOutline();
          unpaintCartFrost();
          unpaintNavPill();
          unpaintNavIcons();
          unpaintCartBar();
          unpaintInfoChips();
          unwireScrollTop();
          unpaintGlassCards();
          unpaintHeaderPanel();
          unpaintMgrCard();
          unpaintCartSummary();
          unpaintSubCatGreen();
          unpadSubCatStrip();
          unpaintCatChipFill();
          unpaintSectionBands();
        }

        function unpaintGlassOnly() {
          var g = document.querySelectorAll('[' + GLASS_ATTR + ']');
          for (var j = 0; j < g.length; j++) g[j].removeAttribute(GLASS_ATTR);
          unpaintNavGlass();
          unpaintNavDark();
